---
/* ============================================================================
   LaunchStory.astro: a project told as chapters, numbered with the
   homepage's lifecycle stages, so the process the homepage promises shows on
   real work (his pick, 2026-09-25).

   Since 2026-10-02 (his call: one page layout everywhere) every chapter is a
   shelf on the shared case shell (styles/case.css), like the Work pages and
   every other project page: the stage number and name, then the heading, in
   the left column; the text, then the visual, on the right.
   ========================================================================= */
import type { CollectionEntry } from 'astro:content';
import { STAGES } from '../../config/lifecycle';
import StoryVisual from './StoryVisual.astro';
import '../../styles/story.css';
import '../../styles/case.css';

type Story = NonNullable<CollectionEntry<'work'>['data']['story']>;
interface Props {
  story: Story;
}
const { story } = Astro.props;
const stage = (id: string) => {
  const s = STAGES.find((x) => x.id === id);
  if (!s) throw new Error(`Unknown lifecycle stage "${id}" in a launch story`);
  return s;
};
---

<div class="case st-story">
  {
    story.chapters.map((c, i) => {
      const s = stage(c.stage);
      /* 2026-09-28: the first chapter of each stage carries the stage id, so
         the homepage's stage links can land on it (/work/.../#measure). */
      const anchor = story.chapters.findIndex((x) => x.stage === c.stage) === i ? c.stage : undefined;
      return (
        <section id={anchor} class="case-sec st-ch" aria-labelledby={`st-h-${i}`} data-st-chapter>
          <h2 id={`st-h-${i}`} class="case-h">
            <span class="case-num st-ch__stage">{s.n} · {s.label}</span> {c.heading}
          </h2>
          <div class="case-body">
            <div class="case-text">
              {c.body.map((p) => (
                <p class="case-lede">{p}</p>
              ))}
            </div>
            <div class="case-visual">
              <StoryVisual visual={c.visual} results={story.results} />
            </div>
          </div>
          {c.visual.kind === 'results' && story.results && (
            <div class="case-text">
              <p class="case-lede st-ch__insight">{story.results.insight}</p>
              {story.results.next.length > 0 && (
                <div class="case-next">
                  <h3 class="case-sub">What I'd test next</h3>
                  <ul>
                    {story.results.next.map((n) => (
                      <li>{n}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          )}
        </section>
      );
    })
  }

  {
    story.sources.length > 0 && (
      <aside class="case-sec case-sources st-sources" aria-labelledby="st-sources-h">
        <h2 id="st-sources-h" class="case-h">
          Sources
        </h2>
        <ol>
          {story.sources.map((s) => (
            <li>
              <a href={s.url} rel="noopener" target="_blank">
                {s.label}
                <span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ol>
      </aside>
    )
  }
</div>

<script>
  import '../../scripts/story-motion';
</script>
