---
/* ============================================================================
   WorkGrid.astro — the filterable project gallery.
   ----------------------------------------------------------------------------
   FILTERS ARE DERIVED, NOT DECLARED. The buttons come from the categories
   actually present in the collection, in the canonical order defined by
   WORK_CATEGORIES. A category with no projects never renders a button, so
   "Digital Marketing" stays out of the way until the first project claims it
   and then appears by itself. Nothing to remember to switch on.

   FILTERING IS PROGRESSIVE. Every card is in the HTML and visible before any
   script runs, so a crawler and a no-JS visitor see the whole body of work.
   The filter bar ships `hidden` and is revealed by script — a control that
   cannot function should not be on screen.

   WHY `hidden` RATHER THAN `display: none` VIA A CLASS: a filtered-out card
   must leave the tab order as well as the page. `hidden` does both, and it is
   what assistive tech reads. Toggling opacity or visibility alone leaves
   invisible cards focusable, which is the classic keyboard trap in a gallery.

   THE COUNT IS ANNOUNCED. Sighted users see the grid change; a screen-reader
   user gets nothing from a silent DOM mutation, so the result count goes to a
   polite live region.
   ========================================================================= */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { WORK_CATEGORIES, CATEGORY_LABELS, type WorkCategory } from '../content.config';
import { href } from '../lib/url';
import { projectPath, workType } from '../lib/work-path';

interface Props {
  /** Show only featured entries. The homepage does; /work will not. */
  featuredOnly?: boolean;
  /** Only this type's projects, with no filter bar (the /work/<type>/ pages). */
  type?: WorkCategory;
}

const { featuredOnly = false, type } = Astro.props;

const all = await getCollection('work', ({ data }) => !data.draft);

const entries = all
  .filter((e) => (featuredOnly ? e.data.featured : true))
  .filter((e) => (type ? workType(e) === type : true))
  /* Explicit `order`, then title. Never filesystem order, which differs
     between machines and makes the grid reshuffle for no reason. */
  .sort((a, b) =>
    a.data.order !== b.data.order
      ? a.data.order - b.data.order
      : a.data.title.localeCompare(b.data.title),
  );

/* Only the categories that actually have work behind them. */
const present = WORK_CATEGORIES.filter((c) =>
  entries.some((e) => e.data.cats.includes(c)),
) as WorkCategory[];
---

<div class="work">
  {
    !type && present.length > 1 && (
      <div class="work__filters" data-filters hidden>
        <div role="group" aria-label="Filter projects by type" class="work__filter-row">
          <button type="button" class="chip" data-filter="all" aria-pressed="true">
            All <span class="chip__n">{entries.length}</span>
          </button>
          {present.map((c) => (
            <button type="button" class="chip" data-filter={c} aria-pressed="false">
              {CATEGORY_LABELS[c]}
              <span class="chip__n">
                {entries.filter((e) => e.data.cats.includes(c)).length}
              </span>
            </button>
          ))}
        </div>
        {/* Polite: it must not interrupt whatever is being read. */}
        <p class="work__status" data-status role="status" aria-live="polite" />
      </div>
    )
  }

  <ul class="work__grid" data-grid role="list">
    {
      entries.map((entry) => (
        <li class="work__item" data-cats={entry.data.cats.join(' ')}>
          <article class="card">
            <div class="card__media">
              <Image
                class="card__img card__img--light"
                src={entry.data.cover}
                alt={entry.data.coverAlt}
                widths={[320, 640, 960]}
                sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 90vw"
                loading="lazy"
                decoding="async"
              />
              {entry.data.coverDark && (
                <Image
                  class="card__img card__img--dark"
                  src={entry.data.coverDark}
                  alt=""
                  aria-hidden="true"
                  widths={[320, 640, 960]}
                  sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 90vw"
                  loading="lazy"
                  decoding="async"
                />
              )}
            </div>

            <div class="card__body">
              <p class="card__cat">{entry.data.category}</p>
              <h3 class="card__title">
                {/* The whole card is clickable via ::after, but the LINK is on
                    the title — so the accessible name is the project name and
                    not a dump of every word in the card. */}
                <a class="card__link" href={href(projectPath(entry))}>
                  {entry.data.title}
                </a>
              </h3>
              <p class="card__desc">{entry.data.summary}</p>
              {entry.data.tags.length > 0 && (
                <ul class="card__tags" role="list">
                  {entry.data.tags.slice(0, 3).map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        </li>
      ))
    }
  </ul>

  <p class="work__empty" data-empty hidden>
    No projects in that category yet.
  </p>
</div>

<style>
  /* -- Filters ------------------------------------------------------------ */
  .work__filters[hidden] {
    display: none;
  }

  .work__filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-end: var(--space-l);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    padding: var(--space-2xs) var(--space-s);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    color: var(--text-dim);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.03em;
    transition:
      color var(--dur-fast) var(--ease-out-quart),
      border-color var(--dur-fast) var(--ease-out-quart),
      background-color var(--dur-fast) var(--ease-out-quart);
  }

  .chip:hover {
    color: var(--accent);
    border-color: var(--border-strong);
  }

  /* State is carried by fill AND weight, never by colour alone. */
  .chip[aria-pressed='true'] {
    background-color: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .chip__n {
    font-variant-numeric: tabular-nums;
    opacity: 0.65;
    font-size: 0.85em;
  }

  .work__status {
    font-size: var(--step--1);
    color: var(--text-dim);
    margin-block-end: var(--space-m);
    min-block-size: 1.5em;
  }

  /* -- Grid --------------------------------------------------------------- */
  .work__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr));
  }

  .work__item[hidden] {
    display: none;
  }

  /* -- Card --------------------------------------------------------------- */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    block-size: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    overflow: hidden;
    background-color: var(--bg-2);
    transition:
      border-color var(--dur-base) var(--ease-out-quart),
      transform var(--dur-base) var(--ease-out-quart);
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--border-strong);
    transform: translateY(-3px);
  }

  .card__media {
    position: relative;
    display: grid;
    aspect-ratio: 4 / 3;
    background-color: var(--bg-3);
    overflow: hidden;
  }

  .card__img {
    grid-area: 1 / 1;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out-expo);
  }

  .card:hover .card__img {
    transform: scale(1.03);
  }

  /* The dark cover only exists on entries that need one; where it does, the
     same three-state theme logic used everywhere else decides which shows. */
  .card__img--dark {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .card__img--dark {
      display: block;
    }
    :root:not([data-theme='light']) .card__img--dark ~ .card__img--light,
    :root:not([data-theme='light']) .card__media:has(.card__img--dark) .card__img--light {
      display: none;
    }
  }

  :root[data-theme='dark'] .card__media:has(.card__img--dark) .card__img--light {
    display: none;
  }

  :root[data-theme='dark'] .card__img--dark {
    display: block;
  }

  :root[data-theme='light'] .card__img--dark {
    display: none;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding: var(--space-s);
  }

  .card__cat {
    font-size: var(--step--1);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .card__title {
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }

  /* The card is one big target, but only the title is a link. ::after spreads
     that link over the whole card without nesting anything inside it. */
  .card__link {
    text-decoration: none;
    color: inherit;
  }

  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card__link:hover {
    color: var(--accent);
  }

  /* Focus belongs on the card, not on the invisible stretched pseudo-element,
     or the ring draws around nothing. */
  .card__link:focus-visible {
    outline: none;
  }

  .card:focus-within {
    outline: var(--ring-width) solid var(--accent);
    outline-offset: var(--ring-offset);
  }

  .card__desc {
    font-size: var(--step-0);
    color: var(--text-dim);
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-2xs);
  }

  .card__tags li {
    font-size: var(--step--1);
    color: var(--text-dim);
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
    padding: 0.1em 0.5em;
  }

  .work__empty {
    color: var(--text-dim);
    padding-block: var(--space-xl);
    text-align: center;
  }

  .work__empty[hidden] {
    display: none;
  }

  @media (forced-colors: active) {
    .card {
      border-color: CanvasText;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.work');
  const bar = root?.querySelector<HTMLElement>('[data-filters]');
  const grid = root?.querySelector<HTMLElement>('[data-grid]');
  const empty = root?.querySelector<HTMLElement>('[data-empty]');
  const status = root?.querySelector<HTMLElement>('[data-status]');

  if (root && bar && grid && empty && status) {
    const buttons = Array.from(bar.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const items = Array.from(grid.querySelectorAll<HTMLElement>('[data-cats]'));

    /* Revealed only now that it can actually do something. Before this line
       the bar is `hidden`, so a no-JS visitor is never shown a dead control —
       they just get every project, which is the correct fallback. */
    bar.hidden = false;

    const apply = (filter: string) => {
      let shown = 0;

      for (const item of items) {
        const cats = (item.dataset.cats || '').split(' ');
        const match = filter === 'all' || cats.includes(filter);
        /* `hidden` rather than a class: it removes the card from the tab
           order too, so keyboard focus cannot land on a filtered-out
           project. */
        item.hidden = !match;
        if (match) shown++;
      }

      for (const b of buttons) {
        b.setAttribute('aria-pressed', String(b.dataset.filter === filter));
      }

      empty.hidden = shown > 0;

      const label =
        filter === 'all'
          ? `Showing all ${shown} projects`
          : `Showing ${shown} ${shown === 1 ? 'project' : 'projects'} in ${
              buttons.find((b) => b.dataset.filter === filter)?.textContent?.trim().replace(/\s+\d+$/, '') ?? filter
            }`;
      status.textContent = label;
    };

    /* Deep links: /work/?cat=logo opens filtered, and every choice is written
       back to the URL so a filtered view can be shared. replaceState, not
       pushState: a filter is a view of this page, not a new history entry.
       Unknown keys are ignored rather than showing an empty grid, since the
       buttons only exist for categories that actually have work. */
    const keys = new Set(buttons.map((b) => b.dataset.filter));
    const writeUrl = (filter: string) => {
      const url = new URL(window.location.href);
      if (filter === 'all') url.searchParams.delete('cat');
      else url.searchParams.set('cat', filter);
      history.replaceState(history.state, '', url);
    };

    for (const b of buttons) {
      b.addEventListener('click', () => {
        const filter = b.dataset.filter || 'all';
        apply(filter);
        writeUrl(filter);
      });
    }

    const initial = new URLSearchParams(window.location.search).get('cat');
    if (initial && keys.has(initial)) apply(initial);
  }
</script>
