---
/* ============================================================================
   Devsign8Mark.astro — the Devsign8 wordmark, as inline vector paths.
   ----------------------------------------------------------------------------
   Source: the final wordmark artboard in Jayson's Devsign8.ai, extracted as
   its own 8 path shapes (translated to the origin and rounded to 2dp, the
   same method JMMark.astro's paths were built with) rather than traced, so it
   matches the drawing exactly. Fill is currentColor, so the mark takes the
   colour of whatever it sits in — the footer, currently — and follows the
   theme for free.

   Decorative by default (aria-hidden) because it almost always sits next to
   other identity marks. Pass `label` when the mark stands alone, e.g. as a
   footer link's accessible name.
   ========================================================================= */
interface Props {
  label?: string;
  class?: string;
}
const { label, class: className } = Astro.props;
