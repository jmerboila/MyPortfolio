---
/* ============================================================================
   MotionToggle.astro — the WCAG 2.2.2 mechanism, as a real preference.
   ----------------------------------------------------------------------------
   2.2.2 Pause, Stop, Hide is Level A: moving content lasting more than five
   seconds, shown alongside other content, must be pausable. The hero backdrop
   drifts indefinitely, so this control is a requirement, not a nicety.

   WHY IT LIVES IN THE HEADER
   - It is reachable from every page in the same place, which is what WCAG
     3.2.6 Consistent Help asks for.
   - The header precedes <main> in source order, so a keyboard or screen-reader
     user meets the control BEFORE the moving content it governs — rather than
     having to traverse the animation to reach its own off switch.

   It is a <button> with aria-pressed rather than role="switch", matching the
   music toggle beside it. "Pressed" reads as "reduce motion is on", and the
   label states the action so the two never contradict each other.
   ========================================================================= */
---

<button
  type="button"
  class="icon-button motion-toggle"
  id="motion-toggle"
  aria-pressed="false"
  aria-label="Reduce motion"
  title="Reduce motion"
>
  {/* Two icons in one grid cell, same as the theme toggle. Pause = motion is
      currently running and this will stop it. Play = it is already reduced. */}
  <svg
    class="icon icon--pause"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M9 5v14M15 5v14"></path>
  </svg>
  <svg
    class="icon icon--play"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M7 4.5l12 7.5-12 7.5z"></path>
  </svg>
</button>

<style>
  /* Cross-faded rather than display-swapped, for the same reason as the theme
     icons: `display` cannot be transitioned. */
  .icon--pause,
  .icon--play {
    transition:
      transform var(--dur-base) var(--ease-back),
      opacity var(--dur-fast) var(--ease-out-quart);
  }

  .icon--pause {
    transform: scale(1);
    opacity: 1;
  }

  .icon--play {
    transform: scale(0.4);
    opacity: 0;
  }

  .motion-toggle[aria-pressed='true'] .icon--pause {
    transform: scale(0.4);
    opacity: 0;
  }

  .motion-toggle[aria-pressed='true'] .icon--play {
    transform: scale(1);
    opacity: 1;
  }

  /* State is carried by colour AND by a different icon, so it never depends
     on colour alone (WCAG 1.4.1). */
  .motion-toggle[aria-pressed='true'] {
    color: var(--accent);
  }

  @media (forced-colors: active) {
    .icon--pause,
    .icon--play {
      transition: none;
    }

    .icon--play,
    .motion-toggle[aria-pressed='true'] .icon--pause {
      visibility: hidden;
    }

    .motion-toggle[aria-pressed='true'] .icon--play {
      visibility: visible;
    }
  }
</style>

<script>
  import {
    currentMotion,
    toggleMotion,
    watchSystemMotion,
  } from '../scripts/motion';

  const button = document.getElementById('motion-toggle');

  if (button) {
    /* aria-pressed reflects STATE ("motion is reduced"); the label names the
       ACTION. Both are recomputed from the single source of truth rather than
       toggled independently, so they cannot drift apart. */
    const sync = () => {
      const reduced = currentMotion() === 'reduced';
      button.setAttribute('aria-pressed', String(reduced));
      const label = reduced ? 'Allow motion' : 'Reduce motion';
      button.setAttribute('aria-label', label);
      button.setAttribute('title', label);
    };

    button.addEventListener('click', () => {
      toggleMotion();
      sync();
    });

    window.addEventListener('motionchange', sync);
    watchSystemMotion();
    sync();
  }
</script>
