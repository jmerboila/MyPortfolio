---
/* ============================================================================
   SocialShelves.astro: /work/social/ as one band per project (his pick,
   2026-09-25); the band itself is the shared Shelf since 2026-09-26. A
   project is a Work entry; posts join it through `work:`. The pieces stay
   playable in place, and "Read the story" appears when the
   project has a launch story. Posts with no project get a shelf of their own.
   ========================================================================= */
import type { CollectionEntry } from 'astro:content';
import SocialPost from './SocialPost.astro';
import PostRow from './PostRow.astro';
import { groupShelves } from '../../config/social';
import Shelf from '../v3/Shelf.astro';
import WorkCover from '../v3/WorkCover.astro';
import { projectPath } from '../../lib/work-path';
import '../../styles/social.css';

interface Props {
  entries: CollectionEntry<'social'>[];
  projects: CollectionEntry<'work'>[];
}
const { entries, projects } = Astro.props;
const shelves = groupShelves(entries, projects);
/* A Social project with no posts (the UNF concepts, 2026-10-27: they never
   ran) still gets a shelf, with its cover in place of the posts. */
const posted = new Set(entries.map((e) => e.data.work?.id));
const unposted = projects
  .filter((p) => p.data.cats.includes('social') && !posted.has(p.id))
  .sort((a, b) => a.data.order - b.data.order);
---

<div class="shelves sp-feed" data-sp-feed>
  {
    shelves.map((s, i) => (
      <Shelf
        index={i}
        id={`sp-shelf-${i}`}
        label={s.label}
        title={s.title}
        idea={s.idea}
        note={s.note}
        link={s.storyPath ? { text: 'Read the story', path: s.storyPath, context: `: ${s.title}` } : undefined}
      >
        {/* More than one piece: one swipeable row, each uncropped and side
            by side, instead of wrapping into stacked rows (his call for the
            Mustang, 2026-09-26, matching the Toolkit). */}
        {s.posts.length > 1 ? (
          <PostRow posts={s.posts} label={s.title} />
        ) : (
          <ul class="sp-shelf__pieces" role="list">
            {s.posts.map((p) => (
              <li>
                <SocialPost entry={p} />
              </li>
            ))}
          </ul>
        )}
      </Shelf>
    ))
  }
  {
    unposted.map((p, i) => (
      <Shelf
        index={shelves.length + i}
        id={`sp-shelf-${shelves.length + i}`}
        label={p.data.category}
        title={p.data.title}
        idea={p.data.campaign?.idea ?? p.data.summary}
        note={p.data.client}
        link={{ text: 'Read the story', path: projectPath(p), context: `: ${p.data.title}` }}
      >
        <WorkCover entry={p} size="large" />
      </Shelf>
    ))
  }
</div>

<script>
  import { initSocial } from '../../scripts/social';
  initSocial();
</script>
