---
/* ============================================================================
   SocialShelves.astro: /work/social/ as one band per project (his pick,
   2026-09-25); the band itself is the shared Shelf since 2026-09-26. A
   project is a Work entry; posts join it through `work:`. The pieces stay
   playable in place, and "Read the story" appears when the
   project has a launch story. Posts with no project get a shelf of their own.
   ========================================================================= */
import type { CollectionEntry } from 'astro:content';
import SocialPost from './SocialPost.astro';
import PostRow from './PostRow.astro';
import { groupShelves } from '../../config/social';
import Shelf from '../v3/Shelf.astro';
import WorkCover from '../v3/WorkCover.astro';
import { projectPath } from '../../lib/work-path';
import '../../styles/social.css';

interface Props {
  entries: CollectionEntry<'social'>[];
  projects: CollectionEntry<'work'>[];
}
const { entries, projects } = Astro.props;
/* Only Social Media projects: a project moved to another type (Lexus went to
   Print Media, 2026-10-27) takes its posts with it. */
const social = projects.filter((p) => p.data.cats.includes('social'));
const socialIds = new Set(social.map((p) => p.id));
const shown = entries.filter((e) => !e.data.work || socialIds.has(e.data.work.id));
const shelves = groupShelves(shown, social);
/* A Social project with no posts (the UNF concepts, 2026-10-27: they never
   ran) still gets a shelf, with its cover in place of the posts. */
const posted = new Set(shown.map((e) => e.data.work?.id));
const unposted = social.filter((p) => !posted.has(p.id));
type Band = { key: string; title: string; label?: string; idea?: string; note?: string; storyPath?: string; posts: CollectionEntry<'social'>[]; cover?: CollectionEntry<'work'> };
/* His order (2026-10-27). Anything not listed follows, in post order. */
const ORDER = ['series:trends', 'work:unf', 'work:2026-ford-mustang-gtd', 'series:getfound', 'series:tutorials', 'work:devsign8-ig-safe-zone-toolkit'];
const rank = (k: string) => (ORDER.includes(k) ? ORDER.indexOf(k) : ORDER.length);
const bands: Band[] = [
  ...shelves,
  ...unposted.map((p) => ({
    key: `work:${p.id}`,
    title: p.data.title,
    label: p.data.category,
    idea: p.data.campaign?.idea ?? p.data.summary,
    note: p.data.client,
    storyPath: projectPath(p),
    posts: [],
    cover: p,
  })),
].sort((a, b) => rank(a.key) - rank(b.key));
---

<div class="shelves sp-feed" data-sp-feed>
  {
    bands.map((s, i) => (
      <Shelf
        index={i}
        id={`sp-shelf-${i}`}
        label={s.label}
        title={s.title}
        idea={s.idea}
        note={s.note}
        link={s.storyPath ? { text: 'Read the story', path: s.storyPath, context: `: ${s.title}` } : undefined}
      >
        {/* More than one piece: one swipeable row, each uncropped and side
            by side, instead of wrapping into stacked rows (his call for the
            Mustang, 2026-09-26, matching the Toolkit). */}
        {s.cover ? (
          <WorkCover entry={s.cover} size="large" />
        ) : s.posts.length > 1 ? (
          <PostRow posts={s.posts} label={s.title} />
        ) : (
          <ul class="sp-shelf__pieces" role="list">
            {s.posts.map((p) => (
              <li>
                <SocialPost entry={p} />
              </li>
            ))}
          </ul>
        )}
      </Shelf>
    ))
  }
</div>

<script>
  import { initSocial } from '../../scripts/social';
  initSocial();
</script>
