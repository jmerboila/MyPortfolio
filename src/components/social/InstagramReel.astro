---
/* ============================================================================
   InstagramReel.astro — a Reel as the Reels viewer draws it.
   ----------------------------------------------------------------------------
   9:16, full-bleed video, the action rail on the right, the caption
   bottom-left (no account name, avatar or audio line since 2026-11-02, his call). Trimmed 2026-09-29 (his call: cleaner, same feel):
   the rail keeps like, comment and share; the ⋯, the spinning audio square
   and the Follow pill are gone. Always dark, whatever the site theme: the Reels
   viewer is dark in both of Instagram's modes, because it sits on video.

   Text over video sits on a scrim, not on the footage. Contrast of white text
   over an unknown frame cannot be verified, so the scrim is what guarantees
   it — see .sp-vert__scrim in social.css.
   ========================================================================= */
import type { CollectionEntry } from 'astro:content';
import SocialIcon from './SocialIcon.astro';
import SocialVideo from './SocialVideo.astro';
import { captionParts, compactCount } from '../../config/social';

type Data = Extract<CollectionEntry<'social'>['data'], { type: 'instagram-reel' }>;

interface Props {
  data: Data;
  id: string;
}

const { data, id } = Astro.props;
const { stats } = data;
---

<article class="sp-vert sp-reel" aria-label={`Instagram Reel: ${data.title}`}>
  <SocialVideo
    src={data.video.src}
    poster={data.video.poster}
    alt={data.video.alt}
    label={data.title}
    captions={data.video.captions}
  >
    <span class="sp-vert__scrim" aria-hidden="true"></span>

    <div class="sp-vert__top" aria-hidden="true">
      {/* The piece's name where Instagram writes "Reels" (his call,
          2026-09-26), so each Reel in a row is labelled at a glance. */}
      <span class="sp-reel__title">{data.piece ?? data.title}</span>
    </div>

    <div class="sp-rail">
      <button type="button" class="sp-rail__item sp-act--like" data-sp-like aria-pressed="false" aria-label="Like">
        <SocialIcon name="heart" size={28} class="sp-when-off" />
        <SocialIcon name="heart" filled size={28} class="sp-when-on" />
        {stats.likes !== undefined && <span class="sp-rail__n">{compactCount(stats.likes)}</span>}
      </button>
      <span class="sp-rail__item" aria-hidden="true">
        <SocialIcon name="comment" size={28} />
        {stats.comments !== undefined && <span class="sp-rail__n">{compactCount(stats.comments)}</span>}
      </span>
      <span class="sp-rail__item" aria-hidden="true">
        <SocialIcon name="send" size={28} />
        {stats.shares !== undefined && <span class="sp-rail__n">{compactCount(stats.shares)}</span>}
      </span>
    </div>

    <div class="sp-vert__bottom">
      {
        data.caption && (
          <div class="sp-caption sp-caption--one" data-sp-caption>
            <p class="sp-caption__text" id={`cap-${id}`}>
              {captionParts(data.caption).map((p) => (p.tag ? <span class="sp-tag">{p.text}</span> : p.text))}
            </p>
            <button type="button" class="sp-caption__more" data-sp-more aria-controls={`cap-${id}`} hidden>
              more
            </button>
          </div>
        )
      }
    </div>
  </SocialVideo>
</article>
