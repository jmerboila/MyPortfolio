---
/* ============================================================================
   SocialVideo.astro — one feed video: the element, its controls, a slot for
   the platform chrome drawn over it.
   ----------------------------------------------------------------------------
   Behaviour lives in src/scripts/social.ts and keys off the data-sp-*
   attributes here. Since 2026-09-25 (his call) nothing plays on its own: a
   video waits, poster up, until it is pressed, then plays WITH its sound —
   there is no mute button. Starting one pauses any other, and a video pauses
   when it leaves the screen, so sound never comes from something unseen.

   Because nothing starts itself, WCAG 1.4.2 (audio control) and 2.2.2 (pause)
   are met by the one control every video has: the whole surface is a real
   <button> that toggles play, named for what it will do next.

   preload="none" because a page of these would otherwise fetch every file up
   front. The poster is an optimised still from src/assets, so nothing is blank
   while the video waits.
   ========================================================================= */
import { getImage } from 'astro:assets';
import SocialIcon from './SocialIcon.astro';

interface Props {
  /** A servable URL — already resolved by withMediaUrls (lib/social-media.ts). */
  src: string;
  poster: ImageMetadata;
  alt: string;
  /** Names the controls: "Play video: <label>". */
  label: string;
  captions?: string;
  /** Thin playback bar along the bottom edge. */
  progress?: boolean;
}

const { src, poster, alt, label, captions, progress = true } = Astro.props;

const posterImg = await getImage({ src: poster, width: 720, format: 'webp' });
const type = src.endsWith('.webm') ? 'video/webm' : 'video/mp4';
---

<div class="sp-video" data-sp-video data-state="paused" data-label={label}>
  <video
    class="sp-video__el"
    loop
    playsinline
    preload="none"
    disablepictureinpicture
    poster={posterImg.src}
    aria-label={alt}
  >
    <source src={src} type={type} />
    {captions && <track kind="captions" src={captions} srclang="en" label="English" default />}
  </video>

  <button type="button" class="sp-video__toggle" data-sp-toggle aria-label={`Play video: ${label}`}>
    <span class="sp-video__big">
      <SocialIcon name="play" size={30} />
    </span>
  </button>

  <slot />


  {
    progress && (
      <span class="sp-video__progress" aria-hidden="true">
        <span data-sp-progress />
      </span>
    )
  }
</div>
