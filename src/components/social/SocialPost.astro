---
/* ============================================================================
   SocialPost.astro: picks the frame for a post; underneath, the piece's name
   inside its project (e.g. "Reel Reveal") and, in dev, a draft marker.
   ----------------------------------------------------------------------------
   The platform badge, client line and case-study / "View on" links were
   removed 2026-09-25 (his call): the shelves name the project and each
   piece, and the cards read cleaner as just the work.

   New post type: add its branch below. The `never` check at the end turns a
   forgotten branch into a type error rather than an empty card.
   ========================================================================= */
import type { CollectionEntry } from 'astro:content';
import InstagramPost from './InstagramPost.astro';
import InstagramReel from './InstagramReel.astro';
import TikTokVideo from './TikTokVideo.astro';

interface Props {
  entry: CollectionEntry<'social'>;
}

const { entry } = Astro.props;
const { data, id } = entry;

function assertNever(x: never): never {
  throw new Error(`No frame for social post type "${(x as { type: string }).type}"`);
}
---

<div class="sp-card">
  <div class="sp-card__frame">
    {
      data.type === 'instagram-post' ? (
        <InstagramPost data={data} id={id} />
      ) : data.type === 'instagram-reel' ? (
        <InstagramReel data={data} id={id} />
      ) : data.type === 'tiktok-video' ? (
        <TikTokVideo data={data} id={id} />
      ) : (
        assertNever(data)
      )
    }
  </div>

  {
    ((data.piece && data.type !== 'instagram-reel') || data.draft) && (
      <div class="sp-card__meta">
        {data.piece && data.type !== 'instagram-reel' && <p class="sp-card__piece">{data.piece}</p>}
        {data.draft && (
          <p class="sp-card__line"><span class="sp-badge sp-badge--draft">Draft · dev only</span></p>
        )}
      </div>
    )
  }
</div>
