---
/* ============================================================================
   ToolkitCase.astro: the Safe-Zone Toolkit as a case study (spec
   2026-10-02-toolkit-case-design.md), replacing its launch story.
   01 the interactive viewer, 02 the problem, 03 the research, 04 the tool,
   05 the series (the ten posted Reels), 06 captions and timing, 07 results.
   07 keeps id="measure": the home page's "14x" tile links there.
   One presentation for every case page (2026-10-02): the shell is
   styles/case.css, and the table, gallery, captions and results are drawn by
   the same StoryVisual as the Ford and Lexus pages.
   Light and dark (the design rule): the viewer and the hook video show the
   version opposite the page; screenshots and Reels are real captures.
   ========================================================================= */
import type { CollectionEntry } from 'astro:content';
import { href } from '../../lib/url';
import { SAFE_ZONES, keepClear, safeArea } from '../../config/ig-safe-zones';
import SafeZoneViewer from './SafeZoneViewer.astro';
import PostRow from './PostRow.astro';
import StoryVisual from '../story/StoryVisual.astro';
import '../../styles/story.css';
import '../../styles/case.css';

type Work = CollectionEntry<'work'>['data'];
interface Props {
  d: Work;
  posts: CollectionEntry<'social'>[];
}
const { d, posts } = Astro.props;
const t = d.toolkit!;
const n = (i: number) => String(i).padStart(2, '0');

const table = {
  kind: 'table' as const,
  caption: 'Instagram formats and their safe areas (px)',
  columns: ['Format', 'Canvas', 'Keep clear (top, right, bottom, left)', 'Safe area'],
  rows: SAFE_ZONES.map((f) => {
    const s = safeArea(f);
    return [f.name, `${f.w} × ${f.h}`, keepClear(f), `${s.w} × ${s.h}`];
  }),
  source: t.research.source,
};
const gallery = { kind: 'gallery' as const, items: t.tool.shots.map((s) => ({ src: s.src, alt: s.alt, note: s.caption })) };
const captions = { kind: 'captions' as const, items: t.captions.items };
const results = { kind: 'results' as const };
---

<div class="case container">
  <section class="case-sec case-open" aria-labelledby="case-h-01">
    <h2 id="case-h-01" class="case-h"><span class="case-num">{n(1)}</span> The toolkit</h2>
    <div class="case-open__text">
      <p class="case-idea">{t.idea}</p>
      <dl class="case-glance">
        <div><dt>Project</dt><dd>{t.type}</dd></div>
        {d.role && <div><dt>Role</dt><dd>{d.role}</dd></div>}
        <div><dt>Deliverables</dt><dd>{t.deliverables.join(', ')}</dd></div>
        {d.tools.length > 0 && <div><dt>Tools</dt><dd>{d.tools.join(', ')}</dd></div>}
      </dl>
    </div>
    <div class="case-open__hero">
      <SafeZoneViewer />
    </div>
  </section>

  <section class="case-sec" aria-labelledby="case-h-02">
    <h2 id="case-h-02" class="case-h"><span class="case-num">{n(2)}</span> The problem</h2>
    <div class="case-body case-body--split">
      <div class="case-text">{t.problem.body.map((p) => <p class="case-lede">{p}</p>)}</div>
      <figure class="tk-hook">
        {
          (['light', 'dark'] as const).map((theme) => (
            <video
              class:list={['tk-hook__video', `tk-hook__video--${theme}`]}
              src={href(t.problem[theme].src)}
              poster={href(t.problem[theme].poster)}
              controls
              muted
              loop
              playsinline
              preload="none"
              aria-label={t.problem.alt}
            />
          ))
        }
        <figcaption>The problem in one line. It became the first Reel's hook.</figcaption>
      </figure>
    </div>
  </section>

  <section class="case-sec" aria-labelledby="case-h-03">
    <h2 id="case-h-03" class="case-h"><span class="case-num">{n(3)}</span> The research</h2>
    <div class="case-body case-body--split">
      <div class="case-text">
        {t.research.body.map((p) => <p class="case-lede">{p}</p>)}
        <p class="tk-callout">{t.research.callout}</p>
        <p class="case-small">{t.research.disclaimer}</p>
      </div>
      <div class="case-visual"><StoryVisual visual={table} /></div>
    </div>
  </section>

  <section class="case-sec" aria-labelledby="case-h-04">
    <h2 id="case-h-04" class="case-h"><span class="case-num">{n(4)}</span> The tool</h2>
    <div class="case-body case-body--split">
      <div class="case-text">{t.tool.body.map((p) => <p class="case-lede">{p}</p>)}</div>
      <div class="case-visual"><StoryVisual visual={gallery} /></div>
    </div>
  </section>

  <section class="case-sec" aria-labelledby="case-h-05">
    <h2 id="case-h-05" class="case-h"><span class="case-num">{n(5)}</span> The series</h2>
    <div class="case-body">
      <div class="case-text"><p class="case-lede">{t.series.body}</p></div>
    </div>
    {posts.length > 0 && (
      <div class="case-posts" data-sp-feed>
        <PostRow posts={posts} label={d.title} />
      </div>
    )}
  </section>

  <section class="case-sec" aria-labelledby="case-h-06">
    <h2 id="case-h-06" class="case-h"><span class="case-num">{n(6)}</span> Captions and timing</h2>
    <div class="case-body case-body--split">
      <div class="case-text">{t.captions.body.map((p) => <p class="case-lede">{p}</p>)}</div>
      <div class="case-visual"><StoryVisual visual={captions} /></div>
    </div>
  </section>

  <section class="case-sec" id="measure" aria-labelledby="case-h-07">
    <h2 id="case-h-07" class="case-h"><span class="case-num">{n(7)}</span> Results and what I learned</h2>
    <div class="case-body case-body--split">
      <div class="case-text">{t.results.body.map((p) => <p class="case-lede">{p}</p>)}</div>
      <div class="case-visual"><StoryVisual visual={results} results={t.results} /></div>
    </div>
    {t.results.next.length > 0 && (
      <div class="case-next">
        <h3 class="case-sub">What I'd test next</h3>
        <ul>{t.results.next.map((x) => <li>{x}</li>)}</ul>
      </div>
    )}
  </section>
</div>

<script>
  import '../../scripts/story-motion';
</script>

<style>
  /* 02: the hook Reel, phone-sized, the version opposite the page. */
  .tk-hook { margin: 0; justify-self: center; inline-size: min(100%, 18rem); display: grid; gap: var(--space-xs); }
  .tk-hook__video { display: block; inline-size: 100%; aspect-ratio: 9 / 16; border-radius: var(--radius-l); border: 1px solid var(--border); background: var(--bg-2); }
  .tk-hook__video--light { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .tk-hook__video--light { display: block; }
    :global(:root:not([data-theme='light'])) .tk-hook__video--dark { display: none; }
  }
  :global(:root[data-theme='dark']) .tk-hook__video--light { display: block; }
  :global(:root[data-theme='dark']) .tk-hook__video--dark { display: none; }
  .tk-hook figcaption { font-size: var(--step--1); color: var(--text-dim); margin: 0; }

  /* 03: the insight most guides miss. */
  .tk-callout { margin: var(--space-xs) 0 0; padding: var(--space-s) var(--space-m); border-inline-start: 3px solid var(--accent); background: var(--bg-2); border-radius: 0 var(--radius-m) var(--radius-m) 0; max-inline-size: 60ch; }
</style>
