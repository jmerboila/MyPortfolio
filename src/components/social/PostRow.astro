---
/* ============================================================================
   PostRow.astro: a swipeable row of posts, for a project with more than
   three pieces (the toolkit's ten Reels). Every post keeps its full frame;
   the row scrolls and snaps instead of wrapping.

   Touch devices swipe. Devices with a mouse also get ‹ › buttons, because a
   thin horizontal scrollbar is easy to miss (UX review, 2026-09-26).
   social.ts (initRows) wires the buttons and hides each one at its end.
   ========================================================================= */
import type { CollectionEntry } from 'astro:content';
import SocialPost from './SocialPost.astro';
import SocialIcon from './SocialIcon.astro';

interface Props {
  posts: CollectionEntry<'social'>[];
  /** Names the row for screen readers, e.g. the project title. */
  label: string;
}
const { posts, label } = Astro.props;
---

<div class="sp-rowwrap" data-sp-row>
  <ul class="sp-reel-row" role="list" tabindex="0" aria-label={`${label}: ${posts.length} posts, scroll sideways for more`}>
    {
      posts.map((p) => (
        <li>
          <SocialPost entry={p} />
        </li>
      ))
    }
  </ul>
  <button type="button" class="sp-row__nav sp-row__nav--prev" data-sp-row-prev aria-label={`Previous posts: ${label}`} hidden>
    <SocialIcon name="chevron-left" size={20} />
  </button>
  <button type="button" class="sp-row__nav sp-row__nav--next" data-sp-row-next aria-label={`Next posts: ${label}`}>
    <SocialIcon name="chevron-right" size={20} />
  </button>
</div>
