---
/* ============================================================================
   PostRow.astro: a swipeable row of posts. Every post keeps its full frame;
   the row scrolls and snaps instead of wrapping.

   Two or three posts (`data-fit`, 2026-09-29, his call): when the row's own
   width has room for all of them at 240px or more, they sit side by side
   with no scrolling, no arrows and no scroll bar (a container query in
   social.css). Narrower, they fall back to the swipe row. Four or more (the
   toolkit's ten Reels) always swipe.

   Touch devices swipe. Devices with a mouse also get ‹ › buttons, because a
   thin horizontal scrollbar is easy to miss (UX review, 2026-09-26).
   social.ts (initRows) wires the buttons and hides each one at its end.
   ========================================================================= */
import type { CollectionEntry } from 'astro:content';
import SocialPost from './SocialPost.astro';
import SocialIcon from './SocialIcon.astro';

interface Props {
  posts: CollectionEntry<'social'>[];
  /** Names the row for screen readers, e.g. the project title. */
  label: string;
}
const { posts, label } = Astro.props;
const fit = posts.length <= 3 ? posts.length : undefined;
---

<div class="sp-rowwrap" data-sp-row>
  <ul
    class="sp-reel-row"
    data-fit={fit}
    role="list"
    tabindex="0"
    aria-label={fit ? `${label}: ${posts.length} posts` : `${label}: ${posts.length} posts, scroll sideways for more`}
  >
    {
      posts.map((p) => (
        <li>
          <SocialPost entry={p} />
        </li>
      ))
    }
  </ul>
  <button type="button" class="sp-row__nav sp-row__nav--prev" data-sp-row-prev aria-label={`Previous posts: ${label}`} hidden>
    <SocialIcon name="chevron-left" size={20} />
  </button>
  <button type="button" class="sp-row__nav sp-row__nav--next" data-sp-row-next aria-label={`Next posts: ${label}`}>
    <SocialIcon name="chevron-right" size={20} />
  </button>
</div>
