---
/* ============================================================================
   CampaignCase.astro: a social campaign as a case study (spec
   2026-10-02-campaign-case-design.md; Ford, then Lexus), replacing its
   launch story. 01 the hero section (idea, glance, the not-affiliated line,
   and the carousel or the posts), then numbered sections that reuse the
   story's visuals (StoryVisual) and show the project's posts by id.
   Light and dark (the design rule): charts, captions and timelines draw in
   HTML on the site's tokens; real captures stay as they are.
   ========================================================================= */
import type { CollectionEntry } from 'astro:content';
import StoryVisual from '../story/StoryVisual.astro';
import PostRow from './PostRow.astro';
import CarouselSwiper from './CarouselSwiper.astro';
import '../../styles/story.css';

type Work = CollectionEntry<'work'>['data'];
interface Props {
  d: Work;
  posts: CollectionEntry<'social'>[];
}
const { d, posts } = Astro.props;
const c = d.campaign!;
const n = (i: number) => String(i).padStart(2, '0');
const pick = (ids: string[]) => ids.map((id) => posts.find((p) => p.id === id || p.id.startsWith(`${id}/`))).filter((p) => p !== undefined);
---

<div class="cc">
  <section class="cc-sec container cc-open" aria-labelledby="cc-h-01">
    <div class="cc-open__text">
      <h2 id="cc-h-01" class="cc-h"><span class="cc-num">{n(1)}</span> {c.heading}</h2>
      <p class="cc-idea">{c.idea}</p>
      <dl class="cc-glance">
        <div><dt>Project</dt><dd>{c.type}</dd></div>
        {d.role && <div><dt>Role</dt><dd>{d.role}</dd></div>}
        <div><dt>Deliverables</dt><dd>{c.deliverables.join(', ')}</dd></div>
        {d.tools.length > 0 && <div><dt>Tools</dt><dd>{d.tools.join(', ')}</dd></div>}
      </dl>
      <p class="cc-small">{c.disclaimer}</p>
    </div>
    <div class="cc-open__hero" data-sp-feed>
      {c.hero.kind === 'carousel' && <CarouselSwiper artboard={c.hero.artboard} panels={c.hero.panels} alt={c.hero.alt} label={d.title} />}
      {c.hero.kind === 'posts' && posts.length > 0 && <PostRow posts={posts} label={d.title} />}
    </div>
  </section>

  {
    c.sections.map((s, i) => {
      const num = n(i + 2);
      const shown = s.posts ? pick(s.posts) : [];
      return (
        <section class="cc-sec container" id={s.anchor} aria-labelledby={`cc-h-${num}`}>
          <h2 id={`cc-h-${num}`} class="cc-h"><span class="cc-num">{num}</span> {s.heading}</h2>
          <div class:list={['cc-body', s.visual && 'cc-body--split']}>
            <div class="cc-text">{s.body.map((p) => <p class="cc-lede">{p}</p>)}</div>
            {s.visual && (
              <div class="cc-visual">
                <StoryVisual visual={s.visual} results={c.results} />
              </div>
            )}
          </div>
          {shown.length > 0 && (
            <div class="cc-posts" data-sp-feed>
              <PostRow posts={shown} label={`${d.title}: ${s.heading}`} />
            </div>
          )}
          {s.visual?.kind === 'results' && c.results && c.results.next.length > 0 && (
            <div class="cc-next">
              <h3 class="cc-sub">What I'd test next</h3>
              <ul>{c.results.next.map((x) => <li>{x}</li>)}</ul>
            </div>
          )}
        </section>
      );
    })
  }

  {
    c.sources.length > 0 && (
      <section class="cc-sec container cc-sources" aria-label="Research sources">
        <h3 class="cc-sub">Sources</h3>
        <ul>
          {c.sources.map((s) => (
            <li><a href={s.url} rel="noopener" target="_blank">{s.label}</a></li>
          ))}
        </ul>
      </section>
    )
  }
</div>

<script>
  import '../../scripts/story-motion';
</script>

<style>
  .cc { display: grid; gap: var(--space-section); }
  .cc-sec { display: grid; gap: var(--space-m); }
  .cc-h { font-size: var(--step-3); display: flex; gap: 0.6em; align-items: baseline; margin: 0; }
  .cc-num { font-size: var(--step--1); letter-spacing: var(--tracking-caps); color: var(--accent); font-variant-numeric: tabular-nums; }
  .cc-sub { font-size: var(--step-0); margin: 0 0 var(--space-xs); }
  .cc-lede { font-size: var(--step-1); color: var(--text-dim); margin: 0; max-inline-size: 60ch; }
  .cc-small { font-size: var(--step--1); color: var(--text-dim); margin: 0; }

  .cc-open { gap: var(--space-l); align-items: center; }
  @media (min-width: 56rem) {
    .cc-open { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--space-xl); }
  }
  .cc-open__text { display: grid; gap: var(--space-m); }
  .cc-open__hero { min-inline-size: 0; }
  .cc-idea { font-size: var(--step-2); max-inline-size: 30ch; margin: 0; line-height: var(--leading-snug); }
  .cc-glance { display: flex; flex-wrap: wrap; gap: var(--space-m) var(--space-xl); margin: 0; padding-block: var(--space-m); border-block: 1px solid var(--border); }
  .cc-glance dt { font-size: var(--step--1); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--text-dim); }
  .cc-glance dd { margin: 0; font-weight: 600; }

  .cc-body { display: grid; gap: var(--space-l); }
  .cc-text { display: grid; gap: var(--space-s); align-content: start; }
  @media (min-width: 56rem) {
    .cc-body--split { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); column-gap: var(--space-xl); align-items: start; }
  }
  .cc-visual { min-inline-size: 0; }
  .cc-posts { min-inline-size: 0; }

  .cc-next ul, .cc-sources ul { margin: 0; padding-inline-start: 1.2em; display: grid; gap: var(--space-2xs); color: var(--text-dim); }
  .cc-sources a { color: var(--text-dim); }
</style>
