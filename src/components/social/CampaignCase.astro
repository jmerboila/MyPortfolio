---
/* ============================================================================
   CampaignCase.astro: a social campaign as a case study (spec
   2026-10-02-campaign-case-design.md; Ford, then Lexus), replacing its
   launch story. 01 the hero section (idea, glance, the not-affiliated line,
   and the carousel or the posts), then numbered sections that reuse the
   story's visuals (StoryVisual) and show the project's posts by id.
   Light and dark (the design rule): charts, captions and timelines draw in
   HTML on the site's tokens; real captures stay as they are.
   ========================================================================= */
import type { CollectionEntry } from 'astro:content';
import StoryVisual from '../story/StoryVisual.astro';
import PostRow from './PostRow.astro';
import CarouselSwiper from './CarouselSwiper.astro';
import '../../styles/story.css';
import '../../styles/case.css';

type Work = CollectionEntry<'work'>['data'];
interface Props {
  d: Work;
  posts: CollectionEntry<'social'>[];
}
const { d, posts } = Astro.props;
const c = d.campaign!;
const n = (i: number) => String(i).padStart(2, '0');
const pick = (ids: string[]) => ids.map((id) => posts.find((p) => p.id === id || p.id.startsWith(`${id}/`))).filter((p) => p !== undefined);
---

<div class="case container">
  <section class="case-sec case-open" aria-labelledby="case-h-01">
    <h2 id="case-h-01" class="case-h"><span class="case-num">{n(1)}</span> {c.heading}</h2>
    <div class="case-open__text">
      <p class="case-idea">{c.idea}</p>
      <dl class="case-glance">
        <div><dt>Project</dt><dd>{c.type}</dd></div>
        {d.role && <div><dt>Role</dt><dd>{d.role}</dd></div>}
        <div><dt>Deliverables</dt><dd>{c.deliverables.join(', ')}</dd></div>
        {d.tools.length > 0 && <div><dt>Tools</dt><dd>{d.tools.join(', ')}</dd></div>}
      </dl>
      <p class="case-small">{c.disclaimer}</p>
    </div>
    <div class="case-open__hero" data-sp-feed>
      {c.hero.kind === 'carousel' && <CarouselSwiper artboard={c.hero.artboard} panels={c.hero.panels} alt={c.hero.alt} label={d.title} />}
      {c.hero.kind === 'posts' && posts.length > 0 && <PostRow posts={posts} label={d.title} />}
    </div>
  </section>

  {
    c.sections.map((s, i) => {
      const num = n(i + 2);
      const shown = s.posts ? pick(s.posts) : [];
      return (
        <section class="case-sec" id={s.anchor} aria-labelledby={`case-h-${num}`}>
          <h2 id={`case-h-${num}`} class="case-h"><span class="case-num">{num}</span> {s.heading}</h2>
          <div class:list={['case-body', s.visual && 'case-body--split']}>
            <div class="case-text">{s.body.map((p) => <p class="case-lede">{p}</p>)}</div>
            {s.visual && (
              <div class="case-visual">
                <StoryVisual visual={s.visual} results={c.results} />
              </div>
            )}
          </div>
          {shown.length > 0 && (
            <div class="case-posts" data-sp-feed>
              <PostRow posts={shown} label={`${d.title}: ${s.heading}`} />
            </div>
          )}
          {s.visual?.kind === 'results' && c.results && c.results.next.length > 0 && (
            <div class="case-next">
              <h3 class="case-sub">What I'd test next</h3>
              <ul>{c.results.next.map((x) => <li>{x}</li>)}</ul>
            </div>
          )}
        </section>
      );
    })
  }

  {
    c.sources.length > 0 && (
      <section class="case-sec case-sources" aria-label="Research sources">
        <h3 class="case-sub">Sources</h3>
        <ul>
          {c.sources.map((s) => (
            <li><a href={s.url} rel="noopener" target="_blank">{s.label}</a></li>
          ))}
        </ul>
      </section>
    )
  }
</div>

<script>
  import '../../scripts/story-motion';
</script>

