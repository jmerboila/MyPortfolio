---
/* ============================================================================
   CarouselSwiper.astro: a seamless carousel as people meet it, in a phone
   frame you can swipe, with the one artboard it was cut from below it
   (Ford's hero, 2026-10-02).
   ----------------------------------------------------------------------------
   Every panel is a window onto the same artboard image (no separate
   exports), so the seam lines up exactly as it did on Instagram. The track
   is a native scroll-snap row: touch swipes, the buttons and the arrow keys
   move it, and the window on the artboard strip follows the panel on screen
   (scripts/carousel-swiper.ts). Without JavaScript the row still scrolls.
   Light and dark (the design rule): the phone's bezel takes the opposite
   tone to the page.

   frame="instagram" (2026-10-26, his call; piloted on /UNF/, then Ford the
   same day): the panels sit in an Instagram feed post instead,
   drawn with InstagramPost's sp- classes from social.css. JM avatar and the
   piece's name in the header, "1/5" and arrows on the image (hidden at the
   ends, as in the app), the action row with the blue page dots. No likes or
   caption: there is no real post to quote. Like InstagramPost, the frame
   follows the site theme.
   ========================================================================= */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import SocialIcon from './SocialIcon.astro';
import JMMark from '../JMMark.astro';
import '../../styles/social.css';

interface Props {
  artboard: ImageMetadata;
  panels: number;
  alt: string;
  label: string;
  /** Replaces the default caption, e.g. for a concept that never ran (/UNF/). */
  caption?: string;
  /** 'phone' (default) or an Instagram feed post. */
  frame?: 'phone' | 'instagram';
}
const { artboard, panels, alt, label, caption, frame = 'phone' } = Astro.props;
const ig = frame === 'instagram';
const img = await getImage({ src: artboard, width: Math.min(artboard.width, 2880), format: 'webp' });
const strip = await getImage({ src: artboard, width: 1600, format: 'webp' });
const panelW = Math.round(artboard.width / panels);
---

<figure
  class:list={['cs', ig && 'cs--ig']}
  data-cs
  data-cs-ig={ig ? '' : undefined}
  data-sp-feed={ig ? '' : undefined}
  style={`--panels:${panels};--ratio:${panelW} / ${artboard.height}`}
>
  <div class:list={['cs__post', ig && 'sp-ig']} role={ig ? 'article' : undefined} aria-label={ig ? `Instagram carousel: ${label}` : undefined}>
  {
    ig && (
      <header class="sp-ig__head">
        <span class="sp-avatar"><JMMark /></span>
        <p class="sp-ig__who"><span class="sp-ig__handle">{label}</span></p>
      </header>
    )
  }
  <div class={ig ? 'cs__media' : 'cs__phone'}>
    <div
      class="cs__track"
      data-cs-track
      tabindex="0"
      role="group"
      aria-roledescription="carousel"
      aria-label={`${label}: ${panels} panels. Swipe, or use the arrow keys.`}
    >
      {
        Array.from({ length: panels }, (_, i) => (
          <div class="cs__panel" role="group" aria-roledescription="slide" aria-label={`Panel ${i + 1} of ${panels}`}>
            <img
              src={img.src}
              alt={i === 0 ? alt : ''}
              aria-hidden={i === 0 ? undefined : 'true'}
              style={`inset-inline-start:${-i * 100}%;inline-size:${panels * 100}%`}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </div>
        ))
      }
    </div>
    {
      ig ? (
        <>
          <span class="sp-carousel__count" data-cs-count aria-live="polite">1/{panels}</span>
          <button type="button" class="sp-carousel__nav sp-carousel__nav--prev" data-cs-prev aria-label="Previous panel" disabled>
            <SocialIcon name="chevron-left" size={16} />
          </button>
          <button type="button" class="sp-carousel__nav sp-carousel__nav--next" data-cs-next aria-label="Next panel">
            <SocialIcon name="chevron-right" size={16} />
          </button>
        </>
      ) : (
        <div class="cs__dots" aria-hidden="true">
          {Array.from({ length: panels }, (_, i) => <span data-cs-dot class:list={[i === 0 && 'is-on']} />)}
        </div>
      )
    }
  </div>
  {
    ig && (
      <div class="sp-ig__actions" aria-hidden="true">
        <span class="sp-act"><SocialIcon name="heart" /></span>
        <span class="sp-act"><SocialIcon name="comment" /></span>
        <span class="sp-act"><SocialIcon name="send" /></span>
        <span class="sp-dots">
          {Array.from({ length: panels }, (_, i) => <span class:list={['sp-dot', i === 0 && 'is-on']} data-cs-dot />)}
        </span>
        <span class="sp-act sp-act--save"><SocialIcon name="bookmark" /></span>
      </div>
    )
  }
  </div>

  {
    !ig && (
      <div class="cs__controls">
        <button type="button" class="cs__btn" data-cs-prev aria-label="Previous panel" disabled>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
        <span class="cs__count" data-cs-count aria-live="polite">1 / {panels}</span>
        <button type="button" class="cs__btn" data-cs-next aria-label="Next panel">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>
    )
  }

  <div class="cs__strip">
    <img src={strip.src} alt="" loading="lazy" decoding="async" />
    <span class="cs__window" data-cs-window aria-hidden="true"></span>
    {
      Array.from({ length: panels }, (_, i) => (
        <button type="button" class="cs__seg" data-cs-go={i} aria-label={`Show panel ${i + 1}`} />
      ))
    }
  </div>
  <figcaption>{caption ?? `One ${artboard.width} × ${artboard.height} artboard, cut into ${panels} panels of ${panelW} × ${artboard.height}: swipe it as it ran on Instagram.`}</figcaption>
</figure>

<script>
  import { initCarouselSwipers } from '../../scripts/carousel-swiper';
  initCarouselSwipers();
</script>

<style>
  .cs {
    --bezel: #0e0e0f;
    margin: 0;
    display: grid;
    gap: var(--space-s);
    justify-items: center;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .cs {
      --bezel: #f3f1ec;
    }
  }

  :global(:root[data-theme='dark']) .cs {
    --bezel: #f3f1ec;
  }

  /* The phone frame needs no wrapper; the Instagram post does. */
  .cs__post:not(.sp-ig) {
    display: contents;
  }

  .cs--ig .cs__post {
    inline-size: min(100%, var(--sp-post-w));
  }

  .cs__media {
    position: relative;
  }

  .cs--ig .cs__track {
    border-radius: 0;
  }

  .cs--ig .cs__track:focus-visible {
    outline: 3px solid var(--ig-blue);
    outline-offset: -3px;
  }

  /* As in the app: no back arrow on the first panel, no next on the last. */
  .cs--ig .sp-carousel__nav:disabled {
    display: none;
  }

  .cs--ig .sp-dot.is-on {
    background: var(--ig-blue);
    opacity: 1;
  }

  .cs__phone {
    position: relative;
    inline-size: min(100%, 22rem);
    padding: 0.6rem;
    border-radius: 1.6rem;
    background: var(--bezel);
    box-shadow: 0 1.5rem 3rem -1.5rem rgb(0 0 0 / 0.45);
  }

  .cs__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: 1.1rem;
    outline-offset: 4px;
  }

  .cs__track::-webkit-scrollbar {
    display: none;
  }

  .cs__panel {
    position: relative;
    flex: 0 0 100%;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    scroll-snap-align: start;
  }

  .cs__panel img {
    position: absolute;
    inset-block: 0;
    block-size: 100%;
    max-inline-size: none;
    display: block;
  }

  .cs__dots {
    position: absolute;
    inset-block-end: 1.1rem;
    inset-inline: 0;
    display: flex;
    justify-content: center;
    gap: 6px;
    pointer-events: none;
  }

  .cs__dots span {
    inline-size: 6px;
    block-size: 6px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.45);
  }

  .cs__dots span.is-on {
    background: #fff;
  }

  .cs__controls {
    display: flex;
    align-items: center;
    gap: var(--space-s);
  }

  .cs__btn {
    inline-size: 2.75rem;
    block-size: 2.75rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  .cs__btn:hover:not(:disabled) {
    border-color: var(--accent);
  }

  .cs__btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .cs__btn svg {
    inline-size: 1.1rem;
    block-size: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cs__count {
    min-inline-size: 3.5rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
    color: var(--text-dim);
    font-size: var(--step--1);
  }

  .cs__strip {
    position: relative;
    inline-size: 100%;
    border-radius: var(--radius-m);
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .cs__strip img {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  .cs__window {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    inline-size: calc(100% / var(--panels));
    border: 3px solid var(--accent);
    border-radius: 4px;
    box-shadow: 0 0 0 999px rgb(0 0 0 / 0.35);
    transform: translateX(calc(var(--i, 0) * 100%));
    transition: transform var(--dur-base, 0.3s) var(--ease-out-quart, ease);
    pointer-events: none;
  }

  .cs__seg {
    position: absolute;
    inset-block: 0;
    inline-size: calc(100% / var(--panels));
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .cs__seg:nth-of-type(1) { inset-inline-start: 0; }
  .cs__seg:nth-of-type(2) { inset-inline-start: calc(100% / var(--panels)); }
  .cs__seg:nth-of-type(3) { inset-inline-start: calc(200% / var(--panels)); }
  .cs__seg:nth-of-type(4) { inset-inline-start: calc(300% / var(--panels)); }
  .cs__seg:nth-of-type(5) { inset-inline-start: calc(400% / var(--panels)); }
  .cs__seg:nth-of-type(6) { inset-inline-start: calc(500% / var(--panels)); }

  .cs__seg:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -4px;
  }

  .cs figcaption {
    font-size: var(--step--1);
    color: var(--text-dim);
    text-align: center;
    max-inline-size: 48ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .cs__window {
      transition: none;
    }
  }
</style>
