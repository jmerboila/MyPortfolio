---
/* ============================================================================
   DotGrid.astro — the site's dot field. Pointer-reactive, nothing else.
   ----------------------------------------------------------------------------
   A vanilla port of React Bits' DotGrid, which is React + GSAP + InertiaPlugin.
   GSAP alone is ~27 kB gzipped before the plugin, several times what this whole
   site ships, and the physics it provides is a decaying glide plus an elastic
   return — about forty lines. So the behaviour is reproduced, the dependency
   is not.

   PAGE-WIDE, VIEWPORT-FIXED, AND CLEAR OF THE NAV BY CONSTRUCTION. The canvas
   is fixed and starts at --header-height rather than at 0, so the header band
   is simply outside the drawing surface. There is no scroll position at which
   a dot can appear behind the logo or the links, and no mask is involved.

   Fixed rather than a tall absolute layer: the canvas stays viewport-sized, so
   a 10,000px page costs exactly what a 1,000px page costs. The trade is that
   the field is a still ground the content scrolls over, rather than a texture
   travelling with it.

   --header-height is published by SiteHeader from a ResizeObserver, so the
   inset tracks a real measured bar. The 4.5rem fallback covers only the frame
   before that lands.

   ONE THING THIS DEPENDS ON: sections must not paint an opaque background of
   their own, or they cover the field. .hero carried background-color and had
   to lose it; the body ground shows through instead.

   VISIBILITY AND CONTRAST, RESOLVED TOGETHER. An earlier pass masked the dots
   out of the middle of the viewport to protect text, which worked so well the
   grid was only visible along the edges. The better answer is that the two
   constraints are not actually in tension, because they pull on different
   levers:

     - CONTRAST is governed by dot ALPHA. Compositing a dot over the ground and
       demanding every foreground hold 4.5:1 gives a ceiling of 0.29 on night
       and 0.15 on paper — text-dim binds first, having the least headroom.
     - VISIBILITY is governed by dot SIZE, which is per-pixel and does not
       affect the contrast maths at all.

   So the dots are large enough to see and translucent enough to read through,
   every pairing verified at the worst case of a glyph sitting directly on a
   dot. No mask is needed, which is why there is none.
   ========================================================================= */

interface Props {
  dotSize?: number;
  gap?: number;
  proximity?: number;
  shockRadius?: number;
  shockStrength?: number;
  resistance?: number;
  returnDuration?: number;
  /** Pointer speed (px/s) above which movement pushes dots aside. */
  speedTrigger?: number;
  maxSpeed?: number;
}

const {
  /* Size is the free lever: it drives visibility and does not enter the
     contrast maths at all, since alpha is what tints the ground under a glyph.
     Raise this before touching the alphas below, which are at their ceiling. */
  dotSize = 2,
  gap = 22,
  proximity = 120,
  shockRadius = 200,
  shockStrength = 5,
  resistance = 1050,
  returnDuration = 2.5,
  speedTrigger = 100,
  maxSpeed = 5000,
} = Astro.props;

const config = {
  dotSize,
  gap,
  proximity,
  shockRadius,
  shockStrength,
  resistance,
  returnDuration,
  speedTrigger,
  maxSpeed,
};
---

<div class="dotgrid" data-dotgrid data-config={JSON.stringify(config)} aria-hidden="true">
  <canvas data-dotgrid-canvas></canvas>
</div>

<style>
  .dotgrid {
    position: fixed;
    /* The header band is excluded from the canvas rather than masked out of
       it, so no dot can paint behind the navigation at any scroll position. */
    inset-block-start: var(--header-height, 4.5rem);
    inset-block-end: 0;
    inset-inline: 0;
    /* Above the hero's background, below .hero__content (--z-raised). */
    z-index: 0;
    pointer-events: none;
    overflow: hidden;

    /* SOLVED, not chosen. See the header note: 0.29 is the ceiling on night,
       0.15 on paper, past which text-dim drops below 4.5:1 when a glyph lands
       on a dot. Both themes sit just under their own.

       Paper's ceiling is half of night's because its text-dim starts with less
       headroom (5.89:1 on the bare ground). Light mode's glow is therefore
       quieter — a real consequence of the palette, not an oversight.

       Base and active must DIFFER or the proximity effect does nothing: the
       React Bits example passes the same colour for both, so its interpolation
       resolves to where it started. */
    --dot-base: rgb(18 58 143 / 0.12);
    --dot-active: rgb(18 58 143 / 0.15);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .dotgrid {
      --dot-base: rgb(110 155 255 / 0.18);
      --dot-active: rgb(110 155 255 / 0.28);
    }
  }

  :root[data-theme='dark'] .dotgrid {
    --dot-base: rgb(110 155 255 / 0.18);
    --dot-active: rgb(110 155 255 / 0.28);
  }

  :root[data-theme='light'] .dotgrid {
    --dot-base: rgb(18 58 143 / 0.12);
    --dot-active: rgb(18 58 143 / 0.15);
  }

  canvas {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  /* Decorative colour is discarded by the OS here, and a dot field behind real
     content would only muddy its palette. */
  @media (forced-colors: active) {
    .dotgrid {
      display: none;
    }
  }
</style>

<script>
  import { motionReduced, onMotionChange } from '../scripts/motion';

  type Dot = {
    cx: number;
    cy: number;
    ox: number;
    oy: number;
    vx: number;
    vy: number;
    /** 0 = at rest, 1 = gliding under inertia, 2 = elastic return */
    phase: 0 | 1 | 2;
    rx: number;
    ry: number;
    t: number;
  };

  type Cfg = {
    dotSize: number;
    gap: number;
    proximity: number;
    shockRadius: number;
    shockStrength: number;
    resistance: number;
    returnDuration: number;
    speedTrigger: number;
    maxSpeed: number;
  };

  /* GSAP's elastic.out(amplitude 1, period 0.75), written out. This shape is
     what makes the return read as a spring settling rather than a slide
     stopping, and it is the most recognisable part of the effect. */
  function elasticOut(p: number): number {
    if (p <= 0) return 0;
    if (p >= 1) return 1;
    const period = 0.75;
    const s = period / 4;
    return Math.pow(2, -10 * p) * Math.sin(((p - s) * (2 * Math.PI)) / period) + 1;
  }

  /* Custom properties are NOT normalised: getPropertyValue returns whatever the
     browser last serialised, and for `rgb(110 155 255 / 0.2)` that is the hex8
     `#6e9bff33`. A hand-written rgb() parser reads that as black, and black
     dots on a near-black ground are invisible while still counting as painted.
     So hand the value to the engine and read back what it computed — `color`
     always serialises to rgb()/rgba() whatever went in. */
  const probe = document.createElement('span');
  probe.setAttribute('aria-hidden', 'true');
  probe.style.cssText = 'position:absolute;width:0;height:0;visibility:hidden';
  document.body.appendChild(probe);

  function toRgba(value: string): [number, number, number, number] {
    probe.style.color = '';
    probe.style.color = value.trim();
    const n = getComputedStyle(probe).color.match(/[\d.]+/g);
    if (!n) return [0, 0, 0, 1];
    return [Number(n[0]), Number(n[1]), Number(n[2]), n[3] === undefined ? 1 : Number(n[3])];
  }

  const host = document.querySelector<HTMLElement>('[data-dotgrid]');
  const canvas = host?.querySelector<HTMLCanvasElement>('[data-dotgrid-canvas]');
  const ctx = canvas?.getContext('2d');

  if (host && canvas && ctx) {
    const cfg: Cfg = JSON.parse(host.dataset.config || '{}');
    const cell = cfg.dotSize + cfg.gap;

    let dots: Dot[] = [];
    let base: [number, number, number, number] = [0, 0, 0, 1];
    let active: [number, number, number, number] = [0, 0, 0, 1];
    let width = 0;
    let height = 0;
    let running = false;
    /* The canvas is fixed, so its viewport offset only moves when the header
       height does. Cached rather than measured on every pointermove. */
    let rect = { left: 0, top: 0, right: 0, bottom: 0 };

    function refreshRect() {
      const r = canvas!.getBoundingClientRect();
      rect = { left: r.left, top: r.top, right: r.right, bottom: r.bottom };
    }

    const pointer = { x: -9999, y: -9999, lastX: 0, lastY: 0, lastT: 0, moved: false };

    function readColors() {
      const cs = getComputedStyle(host!);
      base = toRgba(cs.getPropertyValue('--dot-base'));
      active = toRgba(cs.getPropertyValue('--dot-active'));
    }

    /* Whole cells only, with the remainder split evenly so the field is
       centred rather than anchored to one corner. */
    function build() {
      const r = host!.getBoundingClientRect();
      width = r.width;
      height = r.height;
      if (!width || !height) return;

      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas!.width = Math.round(width * dpr);
      canvas!.height = Math.round(height * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      const cols = Math.floor((width + cfg.gap) / cell);
      const rows = Math.floor((height + cfg.gap) / cell);
      const startX = (width - (cell * cols - cfg.gap)) / 2 + cfg.dotSize / 2;
      const startY = (height - (cell * rows - cfg.gap)) / 2 + cfg.dotSize / 2;

      dots = [];
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          dots.push({
            cx: startX + x * cell,
            cy: startY + y * cell,
            ox: 0, oy: 0, vx: 0, vy: 0,
            phase: 0, rx: 0, ry: 0, t: 0,
          });
        }
      }
    }

    function draw() {
      const r = cfg.dotSize / 2;
      const prox = cfg.proximity;
      const proxSq = prox * prox;
      ctx!.clearRect(0, 0, width, height);

      /* Pass 1 — every dot outside the proximity radius shares one colour, so
         they go into a single path and cost a single fill. That is the
         difference between one fill per frame and several thousand. */
      ctx!.beginPath();
      const near: Dot[] = [];
      for (const d of dots) {
        const dx = d.cx - pointer.x;
        const dy = d.cy - pointer.y;
        if (dx * dx + dy * dy <= proxSq) {
          near.push(d);
          continue;
        }
        const x = d.cx + d.ox;
        const y = d.cy + d.oy;
        ctx!.moveTo(x + r, y);
        ctx!.arc(x, y, r, 0, Math.PI * 2);
      }
      ctx!.fillStyle = `rgba(${base[0]},${base[1]},${base[2]},${base[3]})`;
      ctx!.fill();

      /* Pass 2 — only dots near the pointer need an individual colour. */
      for (const d of near) {
        const t = 1 - Math.hypot(d.cx - pointer.x, d.cy - pointer.y) / prox;
        const cr = base[0] + (active[0] - base[0]) * t;
        const cg = base[1] + (active[1] - base[1]) * t;
        const cb = base[2] + (active[2] - base[2]) * t;
        const ca = base[3] + (active[3] - base[3]) * t;
        ctx!.beginPath();
        ctx!.arc(d.cx + d.ox, d.cy + d.oy, r, 0, Math.PI * 2);
        ctx!.fillStyle = `rgba(${cr | 0},${cg | 0},${cb | 0},${ca})`;
        ctx!.fill();
      }
    }

    /* Returns true while any dot is still animating — which is what lets the
       loop shut itself down instead of spinning forever. */
    function step(dt: number): boolean {
      let busy = false;
      for (const d of dots) {
        if (d.phase === 1) {
          /* `resistance` is a deceleration in px/s², InertiaPlugin's sense of
             the word: the dot coasts v²/(2·resistance) pixels. Both terms are
             per-second, so dt must come out of milliseconds — multiplying by
             raw dt sends the dot a thousand times too far. */
          const dts = dt / 1000;
          const speed = Math.hypot(d.vx, d.vy);
          const drop = cfg.resistance * dts;
          if (speed <= drop) {
            d.vx = 0; d.vy = 0;
            d.phase = 2; d.rx = d.ox; d.ry = d.oy; d.t = 0;
          } else {
            const k = (speed - drop) / speed;
            d.vx *= k; d.vy *= k;
            d.ox += d.vx * dts; d.oy += d.vy * dts;
          }
          busy = true;
        } else if (d.phase === 2) {
          d.t += dt / 1000;
          const p = Math.min(d.t / cfg.returnDuration, 1);
          const e = elasticOut(p);
          d.ox = d.rx * (1 - e);
          d.oy = d.ry * (1 - e);
          if (p >= 1) { d.phase = 0; d.ox = 0; d.oy = 0; } else busy = true;
        }
      }
      return busy;
    }

    let last = 0;
    function loop(now: number) {
      const dt = last ? Math.min(now - last, 50) : 16;
      last = now;
      const busy = step(dt);
      draw();
      if ((busy || pointer.moved) && !motionReduced()) {
        pointer.moved = false;
        requestAnimationFrame(loop);
      } else {
        running = false;
      }
    }

    function wake() {
      if (running) return;
      running = true;
      last = 0;
      requestAnimationFrame(loop);
    }

    function push(d: Dot, vx: number, vy: number) {
      d.vx = vx; d.vy = vy; d.phase = 1;
    }

    /* -- Pointer. The canvas is fixed at the viewport origin, so client
       coordinates ARE canvas coordinates — no rect maths needed. ---------- */
    function onMove(e: PointerEvent) {
      if (e.pointerType !== 'mouse' || motionReduced()) return;

      /* Over the navigation, or outside the window, there is nothing to react
         to. Park the pointer and repaint once so any dots left glowing return
         to base rather than freezing lit. */
      const pad = cfg.proximity;
      if (
        e.clientX < rect.left - pad || e.clientX > rect.right + pad ||
        e.clientY < rect.top - pad || e.clientY > rect.bottom + pad
      ) {
        if (pointer.x !== -9999) {
          pointer.x = pointer.y = -9999;
          pointer.moved = true;
          wake();
        }
        return;
      }

      const now = performance.now();
      const dt = pointer.lastT ? now - pointer.lastT : 16;

      let vx = ((e.clientX - pointer.lastX) / dt) * 1000;
      let vy = ((e.clientY - pointer.lastY) / dt) * 1000;
      let speed = Math.hypot(vx, vy);
      if (speed > cfg.maxSpeed) {
        const s = cfg.maxSpeed / speed;
        vx *= s; vy *= s; speed = cfg.maxSpeed;
      }
      pointer.lastT = now;
      pointer.lastX = e.clientX;
      pointer.lastY = e.clientY;
      pointer.x = e.clientX - rect.left;
      pointer.y = e.clientY - rect.top;
      pointer.moved = true;

      if (speed > cfg.speedTrigger) {
        for (const d of dots) {
          if (d.phase !== 0) continue;
          const dx = d.cx - pointer.x;
          const dy = d.cy - pointer.y;
          if (Math.hypot(dx, dy) < cfg.proximity) {
            push(d, dx + vx * 0.005, dy + vy * 0.005);
          }
        }
      }
      wake();
    }

    function onDown(e: PointerEvent) {
      if (motionReduced()) return;
      const px = e.clientX - rect.left;
      const py = e.clientY - rect.top;
      for (const d of dots) {
        const dx = d.cx - px;
        const dy = d.cy - py;
        const dist = Math.hypot(dx, dy);
        if (dist < cfg.shockRadius) {
          const falloff = Math.max(0, 1 - dist / cfg.shockRadius);
          push(d, dx * cfg.shockStrength * falloff, dy * cfg.shockStrength * falloff);
        }
      }
      wake();
    }

    /* -- Wiring ---------------------------------------------------------- */
    readColors();
    build();
    refreshRect();
    draw();

    new ResizeObserver(() => {
      build();
      refreshRect();
      draw();
      wake();
    }).observe(host);

    window.addEventListener('pointermove', onMove, { passive: true });
    window.addEventListener('pointerdown', onDown, { passive: true });

    /* Painted from tokens, so a theme change has to repaint it. A frame's wait
       lets the custom properties settle before they are read back. */
    window.addEventListener('themechange', () => {
      requestAnimationFrame(() => {
        readColors();
        draw();
      });
    });

    /* Reducing motion parks every dot at home and leaves a still field — a
       composed resting state, not an empty box. The grid stays visible. */
    onMotionChange((reduced) => {
      if (reduced) {
        for (const d of dots) {
          d.ox = d.oy = d.vx = d.vy = 0;
          d.phase = 0;
        }
        pointer.x = pointer.y = -9999;
        draw();
      } else {
        wake();
      }
    });
  }
</script>
