---
/* ============================================================================
   DotGrid.astro — the site-wide dot field. Pointer-reactive, scroll-parallaxed.
   ----------------------------------------------------------------------------
   A vanilla port of React Bits' DotGrid, which is React + GSAP + InertiaPlugin.
   GSAP alone is ~27 kB gzipped before the plugin, several times what this whole
   site ships, and the physics it provides here is a decaying glide plus an
   elastic return — about forty lines. So the behaviour is reproduced and the
   dependency is not.

   FIXED, NOT TALL. The canvas is `position: fixed` and viewport-sized, and
   scrolling is applied as an offset inside the drawing maths. A 10,000px page
   therefore costs exactly what a 1,000px page costs. Because the grid is
   periodic, that offset only has to travel one cell before it can wrap — so
   the field scrolls forever off a canvas that never grows.

   THE MASK IS AN ACCESSIBILITY FEATURE, NOT A LOOK. Measured by compositing
   dots over the ground, text over a full-strength dot fell to 1.07:1 on night
   and 1.63:1 on paper. Going full-page would have put that behind every
   heading on the site rather than just the hero. So dots are masked out of the
   centre of the viewport where reading happens and kept in the margins, and
   the active colour is capped below full opacity. Both, deliberately: the mask
   is the fix, the cap is the insurance for anything that slips past it.

   NOTHING HERE STARTS ON ITS OWN. Dots move when a pointer moves or a click
   lands; the field shifts when the visitor scrolls. That is why this needs no
   pause control — WCAG 2.2.2 governs content that moves automatically, and
   user-driven motion is not that. `prefers-reduced-motion` is still honoured
   in full: no parallax, no pointer reaction, a still field.
   ========================================================================= */

interface Props {
  dotSize?: number;
  gap?: number;
  proximity?: number;
  shockRadius?: number;
  shockStrength?: number;
  resistance?: number;
  returnDuration?: number;
  /** Pointer speed (px/s) above which movement pushes dots aside. */
  speedTrigger?: number;
  maxSpeed?: number;
  /** Fraction of scroll distance the field travels. 0 = pinned, 1 = normal. */
  parallax?: number;
}

const {
  dotSize = 2,
  gap = 20,
  proximity = 100,
  shockRadius = 200,
  shockStrength = 5,
  resistance = 1050,
  returnDuration = 2.5,
  speedTrigger = 100,
  maxSpeed = 5000,
  parallax = 0.2,
} = Astro.props;

const config = {
  dotSize,
  gap,
  proximity,
  shockRadius,
  shockStrength,
  resistance,
  returnDuration,
  speedTrigger,
  maxSpeed,
  parallax,
};
---

<div class="dotgrid" data-dotgrid data-config={JSON.stringify(config)} aria-hidden="true">
  <canvas data-dotgrid-canvas></canvas>
</div>

<style>
  .dotgrid {
    position: fixed;
    inset: 0;
    /* Above the body's background, below every positioned section. A negative
       z-index would put it BEHIND the body background and make it invisible —
       0 is the value that works. base.css lifts main and footer to 1. */
    z-index: 0;
    pointer-events: none;
    overflow: hidden;

    /* These alphas are SOLVED, not chosen. Compositing a dot over the ground
       and requiring every foreground to stay at 4.5:1 gives a ceiling of 0.29
       on night and 0.15 on paper. The binding constraint is text-dim, which
       starts with the least headroom (5.89:1 on paper) and therefore runs out
       first. Both themes sit just under their own ceiling.

       Paper's ceiling is half of night's, so the proximity glow is genuinely
       quieter in light mode. That is a real consequence of the palette rather
       than an oversight — light mode simply has less room to spend.

       Two distinct values matter: the React Bits example passes the SAME
       colour for base and active, so its interpolation resolves to where it
       started and the cursor does nothing visible. */
    --dot-base: rgb(18 58 143 / 0.09);
    --dot-active: rgb(18 58 143 / 0.145);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .dotgrid {
      --dot-base: rgb(110 155 255 / 0.16);
      --dot-active: rgb(110 155 255 / 0.28);
    }
  }

  :root[data-theme='dark'] .dotgrid {
    --dot-base: rgb(110 155 255 / 0.16);
    --dot-active: rgb(110 155 255 / 0.28);
  }

  :root[data-theme='light'] .dotgrid {
    --dot-base: rgb(18 58 143 / 0.09);
    --dot-active: rgb(18 58 143 / 0.145);
  }

  /* The reading well. Transparent in the middle of the viewport — where every
     section's content column sits — and opaque toward the edges, so the dots
     read as a frame around the page rather than a texture underneath the text.

     Viewport-relative because the canvas is fixed, which means it protects the
     middle of the SCREEN. That happens to be exactly where a reader's eye is,
     on every section, without the mask needing to know anything about the
     page's structure. */
  canvas {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    -webkit-mask-image: radial-gradient(
      ellipse 78% 62% at 50% 45%,
      transparent 34%,
      rgb(0 0 0 / 0.55) 68%,
      #000 100%
    );
    mask-image: radial-gradient(
      ellipse 78% 62% at 50% 45%,
      transparent 34%,
      rgb(0 0 0 / 0.55) 68%,
      #000 100%
    );
  }

  /* Narrow screens have no margin to spare — the content column is the whole
     viewport, so there is nowhere for dots to live that is not behind text. */
  @media (max-width: 48rem) {
    .dotgrid {
      display: none;
    }
  }

  /* Decorative colour is discarded by the OS here, and a dot field behind real
     content would only muddy its palette. */
  @media (forced-colors: active) {
    .dotgrid {
      display: none;
    }
  }
</style>

<script>
  import { motionReduced, onMotionChange } from '../scripts/motion';

  type Dot = {
    cx: number;
    cy: number;
    ox: number;
    oy: number;
    vx: number;
    vy: number;
    /** 0 = at rest, 1 = gliding under inertia, 2 = elastic return */
    phase: 0 | 1 | 2;
    rx: number;
    ry: number;
    t: number;
  };

  type Cfg = {
    dotSize: number;
    gap: number;
    proximity: number;
    shockRadius: number;
    shockStrength: number;
    resistance: number;
    returnDuration: number;
    speedTrigger: number;
    maxSpeed: number;
    parallax: number;
  };

  /* GSAP's elastic.out(amplitude 1, period 0.75), written out. This shape is
     what makes the return read as a spring settling rather than a slide
     stopping, and it is the most recognisable part of the effect. */
  function elasticOut(p: number): number {
    if (p <= 0) return 0;
    if (p >= 1) return 1;
    const period = 0.75;
    const s = period / 4;
    return Math.pow(2, -10 * p) * Math.sin(((p - s) * (2 * Math.PI)) / period) + 1;
  }

  /* Custom properties are NOT normalised: getPropertyValue returns whatever the
     browser last serialised, and for `rgb(110 155 255 / 0.2)` that is the hex8
     `#6e9bff33`. A hand-written rgb() parser reads that as black, and black
     dots on a near-black ground are invisible while still counting as painted.
     So hand the value to the engine and read back what it computed — `color`
     always serialises to rgb()/rgba() whatever went in. */
  const probe = document.createElement('span');
  probe.setAttribute('aria-hidden', 'true');
  probe.style.cssText = 'position:absolute;width:0;height:0;visibility:hidden';
  document.body.appendChild(probe);

  function toRgba(value: string): [number, number, number, number] {
    probe.style.color = '';
    probe.style.color = value.trim();
    const n = getComputedStyle(probe).color.match(/[\d.]+/g);
    if (!n) return [0, 0, 0, 1];
    return [Number(n[0]), Number(n[1]), Number(n[2]), n[3] === undefined ? 1 : Number(n[3])];
  }

  const host = document.querySelector<HTMLElement>('[data-dotgrid]');
  const canvas = host?.querySelector<HTMLCanvasElement>('[data-dotgrid-canvas]');
  const ctx = canvas?.getContext('2d');

  if (host && canvas && ctx) {
    const cfg: Cfg = JSON.parse(host.dataset.config || '{}');
    const cell = cfg.dotSize + cfg.gap;

    let dots: Dot[] = [];
    let base: [number, number, number, number] = [0, 0, 0, 1];
    let active: [number, number, number, number] = [0, 0, 0, 1];
    let width = 0;
    let height = 0;
    let running = false;
    let shiftY = 0;
    let lastScroll = -1;

    const pointer = { x: -9999, y: -9999, lastX: 0, lastY: 0, lastT: 0, moved: false };

    function readColors() {
      const cs = getComputedStyle(host!);
      base = toRgba(cs.getPropertyValue('--dot-base'));
      active = toRgba(cs.getPropertyValue('--dot-active'));
    }

    /* The grid carries two spare rows — one above, one below — so the parallax
       offset always has a row to bring in and never opens a gap at an edge. */
    function build() {
      const r = host!.getBoundingClientRect();
      width = r.width;
      height = r.height;
      if (!width || !height) return;

      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas!.width = Math.round(width * dpr);
      canvas!.height = Math.round(height * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      const cols = Math.floor((width + cfg.gap) / cell);
      const rows = Math.floor((height + cfg.gap) / cell) + 2;
      const startX = (width - (cell * cols - cfg.gap)) / 2 + cfg.dotSize / 2;
      const startY = (height - (cell * (rows - 2) - cfg.gap)) / 2 + cfg.dotSize / 2 - cell;

      dots = [];
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          dots.push({
            cx: startX + x * cell,
            cy: startY + y * cell,
            ox: 0, oy: 0, vx: 0, vy: 0,
            phase: 0, rx: 0, ry: 0, t: 0,
          });
        }
      }
    }

    /* Scroll travels at `parallax` of page speed, then wraps at one cell.
       Because every row is identical, wrapping is invisible — which is what
       lets a viewport-sized canvas scroll indefinitely. */
    function updateShift() {
      if (motionReduced()) {
        shiftY = 0;
        return false;
      }
      const next = -(((window.scrollY * cfg.parallax) % cell) + cell) % cell;
      if (next === shiftY) return false;
      shiftY = next;
      return true;
    }

    function draw() {
      const r = cfg.dotSize / 2;
      const prox = cfg.proximity;
      const proxSq = prox * prox;
      ctx!.clearRect(0, 0, width, height);

      /* Pass 1 — every dot outside the proximity radius shares one colour, so
         they go into a single path and cost a single fill. That is the
         difference between one fill per frame and several thousand. */
      ctx!.beginPath();
      const near: Dot[] = [];
      for (const d of dots) {
        const py = d.cy + shiftY;
        const dx = d.cx - pointer.x;
        const dy = py - pointer.y;
        if (dx * dx + dy * dy <= proxSq) {
          near.push(d);
          continue;
        }
        const x = d.cx + d.ox;
        const y = py + d.oy;
        ctx!.moveTo(x + r, y);
        ctx!.arc(x, y, r, 0, Math.PI * 2);
      }
      ctx!.fillStyle = `rgba(${base[0]},${base[1]},${base[2]},${base[3]})`;
      ctx!.fill();

      /* Pass 2 — only dots near the pointer need an individual colour. */
      for (const d of near) {
        const py = d.cy + shiftY;
        const t = 1 - Math.hypot(d.cx - pointer.x, py - pointer.y) / prox;
        const cr = base[0] + (active[0] - base[0]) * t;
        const cg = base[1] + (active[1] - base[1]) * t;
        const cb = base[2] + (active[2] - base[2]) * t;
        const ca = base[3] + (active[3] - base[3]) * t;
        ctx!.beginPath();
        ctx!.arc(d.cx + d.ox, py + d.oy, r, 0, Math.PI * 2);
        ctx!.fillStyle = `rgba(${cr | 0},${cg | 0},${cb | 0},${ca})`;
        ctx!.fill();
      }
    }

    /* Returns true while any dot is still animating — which is what lets the
       loop shut itself down instead of spinning forever. */
    function step(dt: number): boolean {
      let busy = false;
      for (const d of dots) {
        if (d.phase === 1) {
          /* `resistance` is a deceleration in px/s², InertiaPlugin's sense of
             the word: the dot coasts v²/(2·resistance) pixels. Both terms are
             per-second, so dt must come out of milliseconds — multiplying by
             raw dt sends the dot a thousand times too far. */
          const dts = dt / 1000;
          const speed = Math.hypot(d.vx, d.vy);
          const drop = cfg.resistance * dts;
          if (speed <= drop) {
            d.vx = 0; d.vy = 0;
            d.phase = 2; d.rx = d.ox; d.ry = d.oy; d.t = 0;
          } else {
            const k = (speed - drop) / speed;
            d.vx *= k; d.vy *= k;
            d.ox += d.vx * dts; d.oy += d.vy * dts;
          }
          busy = true;
        } else if (d.phase === 2) {
          d.t += dt / 1000;
          const p = Math.min(d.t / cfg.returnDuration, 1);
          const e = elasticOut(p);
          d.ox = d.rx * (1 - e);
          d.oy = d.ry * (1 - e);
          if (p >= 1) { d.phase = 0; d.ox = 0; d.oy = 0; } else busy = true;
        }
      }
      return busy;
    }

    let last = 0;
    let dirty = false;
    function loop(now: number) {
      const dt = last ? Math.min(now - last, 50) : 16;
      last = now;
      const busy = step(dt);
      draw();
      if ((busy || pointer.moved || dirty) && !motionReduced()) {
        pointer.moved = false;
        dirty = false;
        requestAnimationFrame(loop);
      } else {
        running = false;
      }
    }

    function wake() {
      if (running) return;
      running = true;
      last = 0;
      requestAnimationFrame(loop);
    }

    function push(d: Dot, vx: number, vy: number) {
      d.vx = vx; d.vy = vy; d.phase = 1;
    }

    /* -- Pointer. The canvas is fixed at the viewport origin, so client
       coordinates ARE canvas coordinates — no rect maths needed. ---------- */
    function onMove(e: PointerEvent) {
      if (e.pointerType !== 'mouse' || motionReduced()) return;
      const now = performance.now();
      const dt = pointer.lastT ? now - pointer.lastT : 16;

      let vx = ((e.clientX - pointer.lastX) / dt) * 1000;
      let vy = ((e.clientY - pointer.lastY) / dt) * 1000;
      let speed = Math.hypot(vx, vy);
      if (speed > cfg.maxSpeed) {
        const s = cfg.maxSpeed / speed;
        vx *= s; vy *= s; speed = cfg.maxSpeed;
      }
      pointer.lastT = now;
      pointer.lastX = e.clientX;
      pointer.lastY = e.clientY;
      pointer.x = e.clientX;
      pointer.y = e.clientY;
      pointer.moved = true;

      if (speed > cfg.speedTrigger) {
        for (const d of dots) {
          if (d.phase !== 0) continue;
          const dx = d.cx - pointer.x;
          const dy = d.cy + shiftY - pointer.y;
          if (Math.hypot(dx, dy) < cfg.proximity) {
            push(d, dx + vx * 0.005, dy + vy * 0.005);
          }
        }
      }
      wake();
    }

    function onDown(e: PointerEvent) {
      if (motionReduced()) return;
      for (const d of dots) {
        const dx = d.cx - e.clientX;
        const dy = d.cy + shiftY - e.clientY;
        const dist = Math.hypot(dx, dy);
        if (dist < cfg.shockRadius) {
          const falloff = Math.max(0, 1 - dist / cfg.shockRadius);
          push(d, dx * cfg.shockStrength * falloff, dy * cfg.shockStrength * falloff);
        }
      }
      wake();
    }

    /* -- Scroll. Passive, and it only wakes the loop when the offset actually
       moved — a scroll of two pixels at 0.2 parallax often does not. ------ */
    function onScroll() {
      if (window.scrollY === lastScroll) return;
      lastScroll = window.scrollY;
      if (updateShift()) {
        dirty = true;
        wake();
      }
    }

    /* -- Wiring ---------------------------------------------------------- */
    readColors();
    build();
    updateShift();
    draw();

    new ResizeObserver(() => {
      build();
      updateShift();
      draw();
      wake();
    }).observe(host);

    window.addEventListener('pointermove', onMove, { passive: true });
    window.addEventListener('pointerdown', onDown, { passive: true });
    window.addEventListener('scroll', onScroll, { passive: true });

    /* Painted from tokens, so a theme change has to repaint it. A frame's wait
       lets the custom properties settle before they are read back. */
    window.addEventListener('themechange', () => {
      requestAnimationFrame(() => {
        readColors();
        draw();
      });
    });

    /* Reducing motion parks every dot at home, drops the parallax offset and
       leaves a still field — a composed resting state, not an empty box. */
    onMotionChange((reduced) => {
      if (reduced) {
        for (const d of dots) {
          d.ox = d.oy = d.vx = d.vy = 0;
          d.phase = 0;
        }
        pointer.x = pointer.y = -9999;
        shiftY = 0;
        draw();
      } else {
        updateShift();
        dirty = true;
        wake();
      }
    });
  }
</script>
