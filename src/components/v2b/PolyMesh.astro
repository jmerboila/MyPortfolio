---
/* ============================================================================
   PolyMesh.astro — a photograph rebuilt as a low-poly mesh that moves.
   ----------------------------------------------------------------------------
   WHAT IT IS. The image is sampled, a point set is chosen with more points
   where the image has detail, those points are Delaunay-triangulated, and each
   triangle is filled with the colour of the photo at its centroid. Every vertex
   carries a depth value, so pointer and scroll displace near vertices further
   than far ones. That parallax between vertices is what reads as three
   dimensions — there is no 3D engine here and no WebGL.

   WHY NOT three.js. A real mesh with displacement and lighting would be more
   capable and would cost 70-150 KB gzipped even tree-shaken, which on a site
   whose entire font payload is ~112 KB would become the single heaviest thing
   on it — and it would introduce a rendering architecture nothing else in this
   codebase uses. delaunator is ~3 KB gzipped and the rest is 2D canvas, which
   is exactly what DotGrid already does. Same trade the dot field made.

   IT INHERITS DotGrid'S RULES, deliberately, because they were paid for once:
     - the rAF loop STOPS when nothing is moving, rather than spinning forever
     - an IntersectionObserver parks it entirely once the hero leaves screen
     - pointer coordinates go through the element rect, cached and refreshed on
       scroll/resize, never measured per pointermove
     - reduced motion gets a designed static state, not a frozen animation

   PROGRESSIVE ENHANCEMENT. The <img> is real and is what ships in the HTML. If
   script never runs, or canvas is unavailable, or getImageData throws, the
   photograph simply stays. The canvas only replaces it after a successful
   first render — so a failure mode is "you see the photo", never "you see
   nothing". The canvas is aria-hidden throughout; the <img> keeps the alt text
   and stays in the accessibility tree either way.

   dt IS IN MILLISECONDS. Smoothing uses 1 - exp(-dt / TAU) with both in ms,
   which is frame-rate independent and sidesteps the px/s-vs-ms error that cost
   real time on the DotGrid port.
   ========================================================================= */
interface Props {
  /** Resolved image URL. Same origin — getImageData taints on cross-origin. */
  src: string;
  width: number;
  height: number;
  alt: string;
  /** Roughly how many vertices to scatter. More = finer mesh, more fill calls. */
  density?: number;
  class?: string;
}

const {
  src,
  width,
  height,
  alt,
  density = 850,
  class: className = '',
} = Astro.props;
---

<figure class={`polymesh ${className}`} data-polymesh data-density={density}>
  <img
    class="polymesh__img"
    data-polymesh-img
    src={src}
    width={width}
    height={height}
    alt={alt}
    decoding="async"
  />
  <canvas class="polymesh__canvas" data-polymesh-canvas aria-hidden="true"></canvas>
</figure>

<style>
  .polymesh {
    position: relative;
    margin: 0;
    inline-size: 100%;
    overflow: hidden;
  }

  .polymesh__img,
  .polymesh__canvas {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  /* Stacked, not swapped: the canvas is layered over the image and the image
     is hidden only once a first frame has actually been painted. Removing the
     image from flow instead would collapse the box if the canvas never
     initialises. */
  .polymesh__canvas {
    position: absolute;
    inset: 0;
    block-size: 100%;
    opacity: 0;
    transition: opacity var(--dur-slow, 600ms) var(--ease-out-expo, ease-out);
  }

  .polymesh.is-live .polymesh__canvas {
    opacity: 1;
  }

  /* visibility, not display — the img must keep occupying the box so the
     figure's height is still driven by the real image ratio. */
  .polymesh.is-live .polymesh__img {
    visibility: hidden;
  }
</style>

<script>
  import Delaunator from 'delaunator';
  import { motionReduced } from '../../scripts/motion';

  const root = document.querySelector<HTMLElement>('[data-polymesh]');
  const img = root?.querySelector<HTMLImageElement>('[data-polymesh-img]');
  const canvas = root?.querySelector<HTMLCanvasElement>('[data-polymesh-canvas]');

  /* How far the nearest vertices travel, in CSS px, at full pointer deflection.
     Small on purpose: the effect is the DIFFERENCE between near and far
     vertices, and a large value just shears the portrait. */
  const POINTER_PUSH = 26;
  const SCROLL_PUSH = 34;
  /* Smoothing time constant in ms. Higher = heavier, more inertial. */
  const TAU = 140;

  if (root && img && canvas) {
    const ctx = canvas.getContext('2d');
    const density = Number(root.dataset.density) || 850;

    /* Vertex arrays, filled by build(). Parallel typed arrays rather than an
       array of objects: this is read once per vertex per frame and the flat
       layout beats chasing pointers through 900 little objects. */
    let vx: Float32Array;
    let vy: Float32Array;
    let vz: Float32Array; // depth 0 (far) .. 1 (near)
    let tri: Uint32Array; // triangle vertex indices, flat, 3 per triangle
    let fills: string[] = []; // one colour per triangle
    let built = false;

    /* Current and target offsets, both normalised -1..1. */
    let curX = 0;
    let curY = 0;
    let tgtX = 0;
    let tgtY = 0;
    let scrollCur = 0;
    let scrollTgt = 0;

    let rect: DOMRect | null = null;
    let raf = 0;
    let onScreen = true;
    let dpr = 1;

    const refreshRect = () => {
      rect = root.getBoundingClientRect();
    };

    /* ---------------------------------------------------------------------
       BUILD — sample the photo, choose points, triangulate, bake colours.
       Runs once, and again on a significant resize. Everything expensive
       lives here; the frame loop below only transforms and fills.
       ------------------------------------------------------------------- */
    const build = () => {
      if (!ctx) return false;

      const cssW = Math.round(root.clientWidth);
      if (cssW < 2) return false;
      const ratio = img.naturalHeight / img.naturalWidth || 1;
      const cssH = Math.round(cssW * ratio);

      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(cssW * dpr);
      canvas.height = Math.round(cssH * dpr);
      canvas.style.height = `${cssH}px`;

      /* Read the photo at a modest working size. The mesh only needs average
         colour per triangle and a rough edge map — sampling at full resolution
         would cost memory for detail that is immediately thrown away. */
      const SW = 220;
      const SH = Math.max(2, Math.round(SW * ratio));
      const off = document.createElement('canvas');
      off.width = SW;
      off.height = SH;
      const octx = off.getContext('2d', { willReadFrequently: true });
      if (!octx) return false;
      octx.drawImage(img, 0, 0, SW, SH);

      let data: Uint8ClampedArray;
      try {
        data = octx.getImageData(0, 0, SW, SH).data;
      } catch {
        /* Tainted canvas. Should not happen same-origin, but if it does the
           <img> is already on screen and stays there. */
        return false;
      }

      const lum = new Float32Array(SW * SH);
      for (let i = 0, p = 0; i < lum.length; i++, p += 4) {
        lum[i] = (0.2126 * data[p] + 0.7152 * data[p + 1] + 0.0722 * data[p + 2]) / 255;
      }

      /* Sobel-ish edge magnitude. Points cluster where this is high, which is
         what puts triangle detail on the features rather than spreading it
         evenly over flat background. */
      const edge = new Float32Array(SW * SH);
      let edgeMax = 1e-6;
      for (let y = 1; y < SH - 1; y++) {
        for (let x = 1; x < SW - 1; x++) {
          const i = y * SW + x;
          const gx = lum[i - 1] - lum[i + 1];
          const gy = lum[i - SW] - lum[i + SW];
          const m = Math.hypot(gx, gy);
          edge[i] = m;
          if (m > edgeMax) edgeMax = m;
        }
      }

      /* -- Point set ----------------------------------------------------- */
      const pts: number[] = [];

      /* The frame. Without these the hull is the convex hull of the interior
         points and the corners of the picture are simply missing. */
      const EDGE_STEPS = 9;
      for (let i = 0; i <= EDGE_STEPS; i++) {
        const t = i / EDGE_STEPS;
        pts.push(t * SW, 0);
        pts.push(t * SW, SH);
        if (i > 0 && i < EDGE_STEPS) {
          pts.push(0, t * SH);
          pts.push(SW, t * SH);
        }
      }

      /* Rejection sampling weighted by edge strength, with a floor so flat
         regions still receive some structure instead of becoming one enormous
         triangle. Capped iterations so a pathological image cannot hang. */
      const target = density;
      let guard = target * 40;
      while (pts.length / 2 < target && guard-- > 0) {
        const x = Math.random() * (SW - 1);
        const y = Math.random() * (SH - 1);
        const i = (y | 0) * SW + (x | 0);
        const w = 0.06 + 0.94 * (edge[i] / edgeMax);
        if (Math.random() < w) pts.push(x, y);
      }

      /* -- Triangulate ---------------------------------------------------- */
      const d = new Delaunator(Float64Array.from(pts));
      tri = Uint32Array.from(d.triangles);

      const n = pts.length / 2;
      vx = new Float32Array(n);
      vy = new Float32Array(n);
      vz = new Float32Array(n);

      const sx = (cssW * dpr) / SW;
      const sy = (cssH * dpr) / SH;
      const cx = SW / 2;
      const cy = SH * 0.45; // eyeline sits above centre on a portrait crop

      for (let i = 0; i < n; i++) {
        const px = pts[i * 2];
        const py = pts[i * 2 + 1];
        vx[i] = px * sx;
        vy[i] = py * sy;

        /* Depth: a radial bulge (the subject stands proud of the background)
           blended with luminance (lit surfaces read as nearer). Vertices on
           the frame are pinned to zero so the picture's edges never detach
           from the box and reveal what is behind the mesh. */
        const onFrame = px <= 0.5 || py <= 0.5 || px >= SW - 0.5 || py >= SH - 0.5;
        if (onFrame) {
          vz[i] = 0;
        } else {
          const dx = (px - cx) / (SW * 0.5);
          const dy = (py - cy) / (SH * 0.5);
          const radial = Math.max(0, 1 - Math.hypot(dx, dy));
          const l = lum[(py | 0) * SW + (px | 0)];
          vz[i] = Math.pow(0.65 * radial + 0.35 * l, 1.4);
        }
      }

      /* -- Bake one colour per triangle ----------------------------------- */
      fills = new Array(tri.length / 3);
      for (let t = 0; t < tri.length; t += 3) {
        const a = tri[t];
        const b = tri[t + 1];
        const c = tri[t + 2];
        const mx = Math.min(SW - 1, Math.max(0, ((pts[a * 2] + pts[b * 2] + pts[c * 2]) / 3) | 0));
        const my = Math.min(
          SH - 1,
          Math.max(0, ((pts[a * 2 + 1] + pts[b * 2 + 1] + pts[c * 2 + 1]) / 3) | 0),
        );
        const p = (my * SW + mx) * 4;
        fills[t / 3] = `rgb(${data[p]} ${data[p + 1]} ${data[p + 2]})`;
      }

      built = true;
      return true;
    };

    /* ---------------------------------------------------------------------
       DRAW — the only thing that runs per frame.
       ------------------------------------------------------------------- */
    const draw = () => {
      if (!ctx || !built) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      const ox = curX * POINTER_PUSH * dpr;
      const oy = (curY * POINTER_PUSH + scrollCur * SCROLL_PUSH) * dpr;

      for (let t = 0, f = 0; t < tri.length; t += 3, f++) {
        const a = tri[t];
        const b = tri[t + 1];
        const c = tri[t + 2];
        const za = vz[a];
        const zb = vz[b];
        const zc = vz[c];

        ctx.beginPath();
        ctx.moveTo(vx[a] + ox * za, vy[a] + oy * za);
        ctx.lineTo(vx[b] + ox * zb, vy[b] + oy * zb);
        ctx.lineTo(vx[c] + ox * zc, vy[c] + oy * zc);
        ctx.closePath();

        const col = fills[f];
        ctx.fillStyle = col;
        /* Stroking each triangle in its own fill colour closes the hairline
           seams that antialiasing leaves between adjacent fills. Cheaper and
           more reliable than expanding every triangle about its centroid. */
        ctx.strokeStyle = col;
        ctx.lineWidth = dpr;
        ctx.fill();
        ctx.stroke();
      }
    };

    /* ---------------------------------------------------------------------
       LOOP — runs only while something is still settling.
       ------------------------------------------------------------------- */
    let last = 0;
    const tick = (now: number) => {
      const dt = last ? Math.min(now - last, 64) : 16;
      last = now;

      /* Frame-rate independent exponential approach. dt and TAU are BOTH in
         milliseconds — see the header note. */
      const k = 1 - Math.exp(-dt / TAU);
      curX += (tgtX - curX) * k;
      curY += (tgtY - curY) * k;
      scrollCur += (scrollTgt - scrollCur) * k;

      draw();

      const settled =
        Math.abs(tgtX - curX) < 0.001 &&
        Math.abs(tgtY - curY) < 0.001 &&
        Math.abs(scrollTgt - scrollCur) < 0.001;

      if (settled) {
        /* Snap exactly, draw the true resting frame, and stop. Leaving the
           loop running to nudge the last thousandth of a pixel is how an
           idle page ends up pinned at 60fps forever. */
        curX = tgtX;
        curY = tgtY;
        scrollCur = scrollTgt;
        draw();
        raf = 0;
        last = 0;
        return;
      }
      raf = requestAnimationFrame(tick);
    };

    const wake = () => {
      if (!raf && onScreen && built) raf = requestAnimationFrame(tick);
    };

    /* ---------------------------------------------------------------------
       INPUT
       ------------------------------------------------------------------- */
    const onPointer = (e: PointerEvent) => {
      if (motionReduced()) return;
      if (!rect) refreshRect();
      if (!rect) return;
      const nx = (e.clientX - (rect.left + rect.width / 2)) / (rect.width / 2);
      const ny = (e.clientY - (rect.top + rect.height / 2)) / (rect.height / 2);
      tgtX = Math.max(-1, Math.min(1, nx || 0));
      tgtY = Math.max(-1, Math.min(1, ny || 0));
      wake();
    };

    const onScroll = () => {
      refreshRect();
      if (motionReduced() || !rect) return;
      /* Negative while the figure sits below the viewport centre, positive
         once it has risen above it. Gives the mesh a slow drift on scroll. */
      const centre = rect.top + rect.height / 2;
      scrollTgt = Math.max(
        -1,
        Math.min(1, (window.innerHeight / 2 - centre) / window.innerHeight),
      );
      wake();
    };

    const start = () => {
      if (!build()) return;
      root.classList.add('is-live');
      refreshRect();

      if (motionReduced()) {
        /* The designed static state: the mesh at rest. It is still the whole
           effect — a photograph rebuilt in triangles — just not a moving one.
           No listeners are attached at all, so nothing can wake it. */
        draw();
        return;
      }

      draw();
      window.addEventListener('pointermove', onPointer, { passive: true });
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      /* Park the loop when the hero is off screen, exactly as DotGrid does. */
      const io = new IntersectionObserver(
        (entries) => {
          onScreen = entries.some((en) => en.isIntersecting);
          if (onScreen) {
            wake();
          } else if (raf) {
            cancelAnimationFrame(raf);
            raf = 0;
            last = 0;
          }
        },
        { threshold: 0 },
      );
      io.observe(root);

      /* Rebuild on a real width change only. Resize fires constantly during a
         drag and build() is the expensive half. */
      let lastW = root.clientWidth;
      const ro = new ResizeObserver(() => {
        const w = root.clientWidth;
        if (Math.abs(w - lastW) < 24) {
          refreshRect();
          return;
        }
        lastW = w;
        if (build()) {
          refreshRect();
          draw();
        }
      });
      ro.observe(root);
    };

    /* decode() resolves once the pixels are actually usable, which `complete`
       alone does not guarantee. The catch covers an already-broken image. */
    const ready = () => {
      img
        .decode()
        .then(start)
        .catch(() => {
          if (img.complete && img.naturalWidth) start();
        });
    };

    if (img.complete && img.naturalWidth) ready();
    else img.addEventListener('load', ready, { once: true });
  }
</script>
