/* ============================================================================
   JMMark.astro — Jayson's JM monogram, as inline vector paths.
   ----------------------------------------------------------------------------
   Source: the final mark in Devsign8/04-Reference/.../Logo Design/JME.ai,
   extracted from the artboard's own path data (4 paths) rather than traced,
   so it matches the drawing exactly. Fill is currentColor, so the mark takes
   the colour of whatever it sits in and follows the theme for free.

   Decorative by default (aria-hidden) because it almost always sits next to
   the name in text. Pass `label` when the mark stands alone.
   ========================================================================= */
interface Props {
  label?: string;
  class?: string;
}
const { label, class: className } = Astro.props;
