---
/* ============================================================================
   Story.astro — "How a project runs": the seven-stage story that replaced
   round 3's three discipline plates.
   ----------------------------------------------------------------------------
   STAGES (src/config/lifecycle.ts) is the single source of the copy and the
   work placement; this component only resolves each stage's `work` ids
   against the content collection and hands the result to <Stage>. StageRail
   reads the same STAGES array independently and un-hides itself once it finds
   these section ids on the page.
   ========================================================================= */
import { getCollection, type CollectionEntry } from 'astro:content';
import '@fontsource-variable/caveat/wght.css';
import { STAGES } from '../../config/lifecycle';
import Stage from './Stage.astro';
import StoryLoop from './StoryLoop.astro';

const entries = await getCollection('work', ({ data }) => !data.draft);
const byId = new Map(entries.map((entry) => [entry.id, entry]));

const stagesWithWork = STAGES.map((stage) => ({
  stage,
  work: stage.work
    .map((id) => byId.get(id))
    .filter((entry): entry is CollectionEntry<'work'> => entry !== undefined),
}));
---

<section id="story" class="v3-story" aria-labelledby="v3-story-title">
  {/* Round 8: the heading screen carries the hand-drawn loop of all seven
      stages (StoryLoop.astro). Wide screens put the heading INSIDE the loop
      (both in one grid cell); phones stack heading, then drawing. */}
  <header class="v3-story__head v3-screen container">
    <div class="v3-story__map">
      <div class="v3-story__title">
        <h2 id="v3-story-title" data-split>How a project runs</h2>
        <p data-split>Seven steps, from the first chat to real results.</p>
      </div>
      <StoryLoop />
    </div>
  </header>

  {stagesWithWork.map(({ stage, work }) => (
    <Stage stage={stage} work={work} />
  ))}
</section>

<style>
  .v3-story__head {
    padding-block: var(--space-l);
    text-align: center;
  }

  .v3-story__map {
    display: grid;
    gap: var(--space-l);
  }

  @media (min-width: 48rem) {
    /* :global — the loop is StoryLoop.astro's root, carrying ITS scope hash,
       so a plain scoped `> *` never matched it. */
    .v3-story__map > :global(*) {
      grid-area: 1 / 1;
    }

    .v3-story__title {
      align-self: center;
      justify-self: center;
      /* Inside the loop: narrower than the ellipse's inner width. */
      max-inline-size: 52%;
      position: relative;
      z-index: 1;
    }
  }

  /* Big enough to anchor the middle of the loop; fits its inner width. */
  .v3-story__head h2 {
    margin: 0;
    font-size: clamp(2.25rem, 1rem + 3.4vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .v3-story__head p {
    margin: var(--space-xs) 0 0;
    color: var(--text-dim);
    font-size: var(--step-1);
  }
</style>
