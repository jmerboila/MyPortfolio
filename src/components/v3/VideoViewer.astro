---
/* ============================================================================
   VideoViewer: the full-screen viewer for the page's ViewerVideos (2026-10-26,
   his call). A <dialog> (Esc and focus return are native) that steps through
   them in page order with buttons, arrow keys and a sideways swipe. Put it
   once per page, after the videos.
   ========================================================================= */
---

<dialog class="viewer" data-viewer-dialog aria-label="Video viewer">
  <div class="viewer__top">
    <p class="viewer__title" data-viewer-title></p>
    <p class="viewer__count" data-viewer-count></p>
    <button type="button" class="viewer__btn" data-viewer-close aria-label="Close the viewer">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
    </button>
  </div>
  <button type="button" class="viewer__btn viewer__nav" data-viewer-step="-1" aria-label="Previous video">
    <svg viewBox="0 0 24 24" width="32" height="32" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
  </button>
  <video class="viewer__video" controls controlslist="nodownload nofullscreen" disablepictureinpicture playsinline preload="none"></video>
  <button type="button" class="viewer__btn viewer__nav" data-viewer-step="1" aria-label="Next video">
    <svg viewBox="0 0 24 24" width="32" height="32" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
  </button>
</dialog>

<script>
  /* Arrow keys step unless the player has focus (there they seek); a
     sideways swipe steps unless it starts on the player's control bar. A
     player's own fullscreen (Firefox, Safari, which ignore controlslist) is
     turned into the viewer, since browser fullscreen cannot show our
     buttons. iPhone fullscreen from inside the viewer stays native. */
  const dialog = document.querySelector<HTMLDialogElement>('[data-viewer-dialog]');
  const player = dialog?.querySelector('video');
  const items = [...document.querySelectorAll<HTMLVideoElement>('video[data-viewer-item]')];

  if (dialog && player && items.length) {
    const title = dialog.querySelector('[data-viewer-title]')!;
    const count = dialog.querySelector('[data-viewer-count]')!;
    let at = 0;

    const show = (i: number, start = 0) => {
      at = (i + items.length) % items.length;
      const v = items[at];
      player.src = v.currentSrc || v.src;
      player.poster = v.poster;
      player.loop = v.loop;
      player.currentTime = start;
      player.setAttribute('aria-label', `Video: ${v.dataset.title}`);
      title.textContent = v.dataset.title ?? '';
      count.textContent = `${at + 1} / ${items.length}`;
      player.play().catch(() => {});
    };

    const open = (i: number) => {
      const v = items[i];
      /* Carry on from where the inline video was, unless it had finished. */
      const start = v.ended ? 0 : v.currentTime;
      v.pause();
      if (!dialog.open) dialog.showModal();
      show(i, start);
    };

    document.addEventListener('click', (e) => {
      const btn = (e.target as Element | null)?.closest?.('[data-viewer-open]');
      const v = btn?.parentElement?.querySelector<HTMLVideoElement>('video[data-viewer-item]');
      if (v) open(items.indexOf(v));
    });

    dialog.addEventListener('click', (e) => {
      const btn = (e.target as Element | null)?.closest?.<HTMLElement>('button');
      if (btn?.hasAttribute('data-viewer-close')) dialog.close();
      else if (btn?.dataset.viewerStep) show(at + Number(btn.dataset.viewerStep));
    });

    dialog.addEventListener('close', () => {
      player.pause();
      player.removeAttribute('src');
      player.load();
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.target === player) return;
      if (e.key === 'ArrowLeft') show(at - 1);
      else if (e.key === 'ArrowRight') show(at + 1);
    });

    let touch: { x: number; y: number } | null = null;
    player.addEventListener('touchstart', (e) => {
      const t = e.touches[0];
      const onControls = t.clientY > player.getBoundingClientRect().bottom - 72;
      touch = e.touches.length === 1 && !onControls ? { x: t.clientX, y: t.clientY } : null;
    }, { passive: true });
    player.addEventListener('touchend', (e) => {
      if (!touch) return;
      const t = e.changedTouches[0];
      const dx = t.clientX - touch.x;
      if (Math.abs(dx) > 60 && Math.abs(t.clientY - touch.y) < 40) show(at + (dx < 0 ? 1 : -1));
      touch = null;
    });

    document.addEventListener('fullscreenchange', () => {
      const el = document.fullscreenElement;
      if (el instanceof HTMLVideoElement && items.includes(el)) {
        document.exitFullscreen().finally(() => open(items.indexOf(el)));
      }
    });
    for (const v of items) {
      v.addEventListener('webkitbeginfullscreen', () => {
        (v as HTMLVideoElement & { webkitExitFullscreen?: () => void }).webkitExitFullscreen?.();
        open(items.indexOf(v));
      });
    }
  }
</script>

<style>
  /* Always black, like a player, in both themes. */
  .viewer {
    inline-size: 100vw;
    block-size: 100dvh;
    max-inline-size: none;
    max-block-size: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #000;
    color: #fff;
  }

  .viewer[open] {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-rows: auto minmax(0, 1fr);
  }

  .viewer__top {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: var(--space-s);
    padding: var(--space-2xs) var(--space-2xs) var(--space-2xs) var(--space-s);
  }

  .viewer__title {
    flex: 1;
    margin: 0;
    font-weight: 600;
  }

  .viewer__count {
    margin: 0;
    font-size: 0.875rem;
    opacity: 0.75;
  }

  .viewer__video {
    inline-size: 100%;
    block-size: 100%;
    background: #000;
  }

  .viewer__btn {
    display: grid;
    place-items: center;
    min-inline-size: var(--tap-min);
    min-block-size: var(--tap-min);
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #fff;
    cursor: pointer;
  }

  .viewer__btn:hover {
    background: rgb(255 255 255 / 0.12);
  }

  .viewer__btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .viewer__nav {
    align-self: center;
    margin-inline: var(--space-2xs);
  }
</style>
