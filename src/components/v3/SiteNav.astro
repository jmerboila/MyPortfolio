---
/* ============================================================================
   SiteNav.astro — v3's header, and the mobile story map it opens.
   ----------------------------------------------------------------------------
   DESKTOP (≥ 64rem): one solid bar — the JM monogram, four labelled icon links,
   "Book a call", the theme toggle. Solid, not a translucent blur: the frosted
   sticky bar is one of the most recognisable AI-template defaults.

   MOBILE (< 64rem): the monogram, theme, Menu. Menu opens a native
   <dialog> via showModal(), which brings Escape-to-close, a focus trap and an
   inert page for free — the things hand-rolled overlays usually get wrong.
   Inside is the story map: the seven lifecycle stages, numbered, each with
   its icon and one line, then the primary links and the booking CTA.

   Every icon sits beside a visible label; icons never name a control alone.
   ========================================================================= */
import { PERSON } from '../../config/site';
import { STAGES, PRIMARY, BOOKING_HREF } from '../../config/lifecycle';
import { href } from '../../lib/url';
import JMMark from '../JMMark.astro';
import Icon from './Icon.astro';
---

<header class="v3-nav" data-v3-header>
  <div class="v3-nav__bar container">
    {/* The monogram alone — the name is the hero's job. The mark carries the
        link's accessible name, since there is no visible text in it. */}
    <a class="v3-nav__brand" href={href('/v3/')}>
      <JMMark class="v3-nav__mark" label={`${PERSON.name}, home`} />
    </a>

    <nav class="v3-nav__links" aria-label="Primary">
      <ul role="list">
        {PRIMARY.map((l) => (
          <li>
            <a href={href(l.href)}>
              <Icon name={l.icon} />
              <span>{l.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="v3-nav__actions">
      <a class="v3-button v3-nav__cta" href={BOOKING_HREF}>
        <Icon name="calendar-check" />
        <span>Book a call</span>
      </a>
      <button type="button" class="v3-iconbtn" id="v3-theme" aria-label="Switch to dark theme">
        <Icon name="sun" class="v3-theme__sun" />
        <Icon name="moon" class="v3-theme__moon" />
        <span class="visually-hidden" data-theme-label>Theme</span>
      </button>
      <button
        type="button"
        class="v3-nav__menu"
        data-menu-open
        aria-haspopup="dialog"
        aria-controls="v3-menu"
      >
        <Icon name="menu" />
        <span>Menu</span>
      </button>
      <a class="v3-backlink" href={href('/')}>&larr; v2</a>
    </div>
  </div>
</header>

<dialog id="v3-menu" class="v3-menu" aria-labelledby="v3-menu-title">
  <div class="v3-menu__top container">
    <JMMark class="v3-nav__mark" />
    <button type="button" class="v3-nav__menu" data-menu-close>
      <Icon name="x" />
      <span>Close</span>
    </button>
  </div>

  <div class="v3-menu__body container">
    <h2 id="v3-menu-title" class="v3-menu__title">How a project runs</h2>
    <ol class="v3-menu__stages" role="list">
      {STAGES.map((s, i) => (
        <li style={`--i: ${i}`}>
          <a href={`#${s.id}`} data-menu-link>
            <span class="v3-menu__n">{s.n}</span>
            <Icon name={s.icon} class="v3-menu__icon" />
            <span class="v3-menu__label">{s.label}</span>
            <span class="v3-menu__line">{s.line}</span>
          </a>
        </li>
      ))}
    </ol>

    <ul class="v3-menu__primary" role="list">
      {PRIMARY.map((l) => (
        <li>
          <a href={href(l.href)} data-menu-link>
            <Icon name={l.icon} />
            <span>{l.label}</span>
          </a>
        </li>
      ))}
    </ul>

    <a class="v3-button v3-menu__cta" href={BOOKING_HREF}>
      <Icon name="calendar-check" />
      <span>Book a discovery call</span>
    </a>
  </div>
</dialog>

<script>
  import { bindThemeToggle } from '../../scripts/theme';

  /* Measured, not guessed: DotGrid and the sticky plates both read it. */
  const header = document.querySelector<HTMLElement>('[data-v3-header]');
  if (header) {
    const publish = () =>
      document.documentElement.style.setProperty('--header-height', `${header.offsetHeight}px`);
    publish();
    new ResizeObserver(publish).observe(header);
  }

  const btn = document.getElementById('v3-theme');
  const label = btn?.querySelector<HTMLElement>('[data-theme-label]');
  if (btn && label) bindThemeToggle(btn, label);

  const menu = document.getElementById('v3-menu');
  if (menu instanceof HTMLDialogElement) {
    const opener = document.querySelector<HTMLButtonElement>('[data-menu-open]');
    opener?.addEventListener('click', () => menu.showModal());
    menu.querySelector('[data-menu-close]')?.addEventListener('click', () => menu.close());

    /* A link inside navigates in-page; close first so the page it scrolls to
       is not left inert behind the modal. */
    menu.querySelectorAll('[data-menu-link]').forEach((a) =>
      a.addEventListener('click', () => menu.close()),
    );

    /* Growing past the breakpoint hides the Menu button; never leave an
       open modal behind a control that no longer exists. */
    matchMedia('(min-width: 64rem)').addEventListener('change', (e) => {
      if (e.matches && menu.open) menu.close();
    });
  }
</script>
