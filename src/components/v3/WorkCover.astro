---
/* ============================================================================
   WorkCover.astro: a project's cover as a link to its page (2026-09-26).
   ----------------------------------------------------------------------------
   With `name` (the /work/ hub rows) the visible name is the link text and
   the image is decorative, so a screen reader hears the project once.
   Without it (the type pages, where the shelf's "See the project" link
   already goes there) the cover is a mouse convenience only: out of the tab
   order and hidden from assistive tech, so it is not a second, unnamed stop.
   Styles: .cover in src/styles/shelves.css.

   A live site (`coverSite`, 2026-09-30) is drawn as the home page draws it:
   desktop in a browser frame with the phone over its corner, in the theme
   opposite the page (SiteShowcase.astro). Decorative here, like the image.
   ========================================================================= */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { href } from '../../lib/url';
import { projectPath } from '../../lib/work-path';
import { SITE_SHOTS } from '../../config/site-shots';
import SiteShowcase from '../SiteShowcase.astro';

interface Props {
  entry: CollectionEntry<'work'>;
  name?: string;
  size: 'small' | 'large';
}

const { entry, name, size } = Astro.props;
const sizes = size === 'large' ? '(min-width: 64rem) 44rem, 92vw' : '(min-width: 64rem) 17rem, (min-width: 40rem) 45vw, 92vw';
const widths = size === 'large' ? [640, 960, 1400] : [320, 640];
---

<a
  class:list={['cover', `cover--${size}`]}
  href={href(projectPath(entry))}
  aria-hidden={name ? undefined : 'true'}
  tabindex={name ? undefined : -1}
>
  {
    entry.data.coverSite ? (
      <span class="cover__frame cover__frame--site">
        <span class="cover__site">
          <SiteShowcase shots={SITE_SHOTS[entry.data.coverSite]} size={size === 'large' ? 'full' : 'card'} decorative />
        </span>
      </span>
    ) : (
      <span class="cover__frame">
        <Image src={entry.data.cover} alt="" widths={widths} sizes={sizes} loading="lazy" decoding="async" />
      </span>
    )
  }
  {name && <span class="cover__name">{name}</span>}
</a>
