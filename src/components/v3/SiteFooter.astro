---
/* ============================================================================
   SiteFooter.astro: the v3 footer, on devsign8.com's layout (his pick,
   2026-09-26).
   ----------------------------------------------------------------------------
   Top row: the large JM Design mark and the tagline on the left; on the
   right, two columns, Explore (one link per type of work) and Connect (the
   social links, drawn as before, not as devsign8.com's round buttons).
   Bottom row, left aligned on the same edge as the mark: the credit line.

   The Explore links come from liveTypes(), the same list that builds the
   /work/<type>/ pages, so a new type shows up here once its first project
   lands, with no edit to this file.

   Not to be confused with ../SiteFooter.astro, the old v2 footer that only
   the 404 page (BaseLayout) still uses.
   ========================================================================= */
import { getCollection } from 'astro:content';
import { PERSON } from '../../config/site';
import { V3_SOCIALS } from '../../config/v3';
import { CATEGORY_LABELS, WORK_CATEGORIES } from '../../content.config';
import { href } from '../../lib/url';
import { liveTypes, typePath } from '../../lib/work-path';
import BrandIcon from './BrandIcon.astro';
import Devsign8Mark from '../Devsign8Mark.astro';
import JMMark from '../JMMark.astro';

const work = await getCollection('work', ({ data }) => !data.draft);
const types = liveTypes(WORK_CATEGORIES, work);
/* No year in the credit: no visible dates anywhere (Jayson, 2026-09-28). */
---

<footer class="v3-footer container">
  <div class="v3-footer__top">
    <div class="v3-footer__id">
      <a class="v3-footer__brand" href={href('/')}>
        <JMMark class="v3-footer__jm" label="JM Design, home" />
      </a>
      <p class="v3-footer__tagline">Planned, made and measured</p>
    </div>

    <div class="v3-footer__cols">
      <nav class="v3-footer__nav" aria-labelledby="v3-footer-explore">
        <h2 id="v3-footer-explore" class="v3-footer__head">Explore</h2>
        <ul role="list">
          {
            types.map((t) => (
              <li>
                <a href={href(typePath(t))}>{CATEGORY_LABELS[t]}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="v3-footer__connect">
        <h2 class="v3-footer__head">Connect</h2>
        <ul class="v3-footer__socials" role="list">
          {
            V3_SOCIALS.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener me" aria-label={`${s.label} (opens in a new tab)`}>
                  {s.icon === 'devsign8' ? <Devsign8Mark class="v3-footer__mark" /> : <BrandIcon name={s.icon} />}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <p class="v3-footer__credit">&copy; JM Design. Designed and built by {PERSON.name}.</p>
</footer>
