---
/* ============================================================================
   Hero.astro — the "name sandwich": Jayson's full name, his 3D mesh head
   layered into it, and an outlined copy of the name stacked above the head so
   the letters it covers still read as an outline across his face.
   ----------------------------------------------------------------------------
   Three layouts:
   - Wide (>= 64rem), his round 5 sketch: the name stacks JAYSON / MERCADO /
     ERBOILA right-aligned in a left column; the head stands in a right column
     that starts just before the name ends, so only the head's hair and ear
     edge meet the letters (round 6 cut the overlap to a sliver).
   - Tablet (40–64rem): centred stack, the head behind the name. He likes it.
   - Phones (< 40rem): the head sits ABOVE the name, its chin just touching
     the top of JAYSON (round 6).

   ONE GRID, every layer in flow (v3-hero__namewrap). No absolute positioning:
   the head's own height sets the rows, and the name and the typewriter line
   centre against it.
     z0  the real <h1> — the accessible name.
     z1  the head image.
     z2  an aria-hidden copy of the name in the SAME grid cell, drawn as an
         outline only, so where the head covers the filled letters the outline
         still traces them.
     z3  the typewriter line.
   h1 and outline share `.v3-hero__title` (identical metrics, identical cell),
   which is what keeps them pixel-aligned.

   HOW THE OUTLINE IS DRAWN. Not -webkit-text-stroke: Inter Tight builds its
   letters from overlapping pieces (the A's crossbar over its legs, the R's
   leg over its bowl, the D's stem) and a text stroke traces every piece, so
   lines showed inside the letters. The static Google cut has the same
   overlaps, so a font swap does not help. Instead the copy is painted SOLID
   and the #v3-hero-outline SVG filter below keeps only a thin ring inside the
   rendered letter's edge (the letter minus itself shrunk by 1.25px). It works
   on pixels, not glyph pieces, so no inner join can show.

   Motion (cursor tilt, touch parallax, the load-time rise, the head's fade-up,
   the typewriter) lives in src/scripts/v3-motion.ts — this component only
   marks the elements with data attributes.
   ========================================================================= */
import { Image } from 'astro:assets';
import meshPortrait from '../../assets/jayson-mesh-portrait.webp';
import { PERSON } from '../../config/site';

const WORDS = PERSON.name.split(' ');

/* The typewriter: a fixed start, three endings typed in turn. The full
   sentence below is what screen readers, reduced motion and no-JS get. */
const TYPE_LEAD = 'I help businesses';
/* Each ending carries its period (round 9): every phrase is a complete
   sentence, and the full stop lands it as a statement before it erases. */
const TYPE_ENDINGS = ['look good.', 'get found.', 'grow online.'];
const TYPE_FULL = 'I help businesses look good, get found and grow online.';
const longestEnding = TYPE_ENDINGS.reduce((a, b) => (b.length > a.length ? b : a));
---

<section class="v3-hero container" aria-labelledby="v3-hero-title" data-hero>
  <svg class="v3-hero__defs" aria-hidden="true" focusable="false" width="0" height="0">
    <filter id="v3-hero-outline" color-interpolation-filters="sRGB">
      <feMorphology in="SourceAlpha" operator="erode" radius="1.25" result="core" />
      <feComposite in="SourceGraphic" in2="core" operator="out" />
    </filter>
  </svg>

  <div class="v3-hero__namewrap">
    <h1 id="v3-hero-title" class="v3-hero__title" data-intro data-hero-tilt>
      {WORDS.map((word, i) => (
        <>
          {i > 0 && ' '}
          <span class="v3-hero__word">{word}</span>
        </>
      ))}
    </h1>

    <div class="v3-hero__head" data-hero-head>
      <Image
        class="v3-hero__head-img"
        src={meshPortrait}
        alt="Jayson's head rendered as a grey 3D polygon mesh, a fine wireframe traced over his face beneath swept-back hair."
        widths={[480, 726]}
        sizes="(min-width: 64rem) 30rem, 70vw"
        loading="eager"
        fetchpriority="high"
        data-hero-head-target
      />
    </div>

    <p class="v3-hero__title v3-hero__title--outline" aria-hidden="true" data-intro data-hero-tilt>
      {WORDS.map((word, i) => (
        <>
          {i > 0 && ' '}
          <span class="v3-hero__word">{word}</span>
        </>
      ))}
    </p>

    <p class="v3-hero__line v3-type" data-typewriter data-endings={JSON.stringify(TYPE_ENDINGS)}>
      <span class="v3-type__full">{TYPE_FULL}</span>
      {/* The sizer holds the longest ending invisibly, so the box never
          changes width while the live copy types — nothing around it moves. */}
      <span class="v3-type__anim" aria-hidden="true">
        <span class="v3-type__sizer">{TYPE_LEAD} <em class="v3-type__ending">{longestEnding}</em></span>
        <span class="v3-type__live">{TYPE_LEAD} <em class="v3-type__ending" data-type-text>{TYPE_ENDINGS[0]}</em><span class="v3-type__caret"></span></span>
      </span>
    </p>
  </div>
</section>

<style>
  .v3-hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-block-size: calc(100svh - var(--header-height, 4.5rem));
    /* The head's soft halo (::before, inset -60% sideways) reaches past the
       screen edge; on phones the browser then widened the whole layout
       viewport to fit it (426px of page on a 390px screen, everything off
       centre). Clip sideways only, so the head's tilt and the name's rise
       can still spill vertically. */
    overflow-x: clip;
    /* Smaller than most sections' --space-2xl: the head already claims most of
       this section's height, and a big padding would push the hero past one
       screen. */
    padding-block: var(--space-l);
  }

  /* -- Phones and tablets (< 64rem): centred stack, head behind the name --- */
  .v3-hero__namewrap {
    container-type: inline-size;
    display: grid;
    grid-template-areas:
      'stage'
      'line';
    row-gap: var(--space-l);
  }

  .v3-hero__title,
  .v3-hero__head {
    grid-area: stage;
  }

  .v3-hero__line {
    grid-area: line;
  }

  /* Shared by the filled h1 and the outline copy — anything that affects line
     breaks or box size MUST live here so the two stay pixel-aligned. */
  .v3-hero__title {
    position: relative;
    z-index: 0;
    align-self: end;
    margin: 0 0 4rem;
    font-family: var(--font-ui);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    line-height: 0.85;
    text-align: center;
    color: var(--text);
    /* Three stacked lines, one word each — "Mercado" (the longest) sets the
       ceiling so it never overflows. */
    font-size: clamp(3.6rem, -0.3rem + 20.3vw, 13rem);
  }

  .v3-hero__word {
    display: block;
  }

  .v3-hero__head {
    position: relative;
    z-index: 1;
    justify-self: center;
    align-self: end;
    block-size: min(55svh, 34rem);
    perspective: 1000px;
    /* Dark hair on night has no silhouette without a lift (v2B finding). */
    --mesh-halo: transparent;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .v3-hero__head {
      --mesh-halo: rgb(169 141 255 / 0.07);
    }
  }
  :root[data-theme='dark'] .v3-hero__head {
    --mesh-halo: rgb(169 141 255 / 0.07);
  }

  .v3-hero__head::before {
    content: '';
    position: absolute;
    inset: -20% -60%;
    background: radial-gradient(45% 42% at 50% 40%, var(--mesh-halo) 0%, transparent 70%);
    pointer-events: none;
  }

  .v3-hero__head-img {
    position: relative;
    display: block;
    block-size: 100%;
    inline-size: auto;
  }

  .v3-hero__title--outline {
    z-index: 2;
    filter: url('#v3-hero-outline');
    pointer-events: none;
  }

  .v3-hero__defs {
    position: absolute;
    inline-size: 0;
    block-size: 0;
    overflow: hidden;
  }

  /* -- Wide screens (>= 64rem): his sketch ---------------------------------
     Three columns as percentages of the content width:
       0 ─ 54.5%   the name's own space
       54.5 ─ 62%  the overlap column. The portrait file has ≈5% of empty,
                   transparent margin on its left, so the VISIBLE hair starts
                   near 59.5% — only ≈2.5% (the hair and ear edge) actually
                   meets the letters, as he asked in round 6
       62 ─ 100%   the rest of the head
     The typewriter line centres under the name (0–62%).
     The head spans every row, so its height sets the block; the 1fr rows
     above and below centre the name + line against it. Placed by line
     numbers, not grid-template-areas: the name and the head share the
     overlap column, and named areas must be non-overlapping rectangles — the
     browser drops the whole map otherwise. */
  @media (min-width: 64rem) {
    .v3-hero__namewrap {
      grid-template-columns: 54.5fr 7.5fr 38fr;
      grid-template-rows: 1fr auto auto 1fr;
      grid-template-areas: none;
      row-gap: 0;
    }

    .v3-hero__title {
      grid-area: 2 / 1 / 3 / 3;
      align-self: auto;
      margin: 0;
      text-align: right;
      /* MERCADO is 4.58em wide in this cut, so 62% of the content width ÷
         4.58 ≈ 13.5cqi fills the name's column exactly at every width (cqi =
         1% of .v3-hero__namewrap, the container). A vw clamp could not: the
         content width peaks near 80rem and shrinks again past it. */
      font-size: 13.4cqi;
    }

    .v3-hero__head {
      grid-area: 1 / 2 / 5 / 4;
      justify-self: start;
      align-self: center;
      /* 70cqi caps the height so the head's width (0.62 × height) never
         exceeds the 45.5% it has from 54.5% to the edge — a tall 1024-wide
         tablet in landscape would otherwise push it past the container. */
      block-size: min(74svh, 46rem, 70cqi);
    }
  }

  /* -- The typewriter line --------------------------------------------------
     Sized so the LONGEST phrase ("I help businesses grow online", ≈12.5em
     with the serif ending) fits one line of its column with room for the
     caret: column width ÷ 13.2. Capped at 2.25rem on wide screens, floored at
     1.125rem so zooming still enlarges it (WCAG 1.4.4); below the floor it
     simply wraps. Centred everywhere; the box is fixed-width (the sizer), so
     centring never makes "I help businesses" shift while the ending types. */
  .v3-hero__line {
    --type-col: 100cqi;
    position: relative;
    z-index: 3;
    justify-self: center;
    margin: 0;
    font-size: max(1.125rem, min(2.25rem, var(--type-col) / 13.2));
    line-height: var(--leading-snug);
    text-align: center;
    text-wrap: balance;
  }

  /* After the base rule above on purpose: same specificity, so the later
     rule wins — placed earlier, its margin was overridden. */
  @media (min-width: 64rem) {
    .v3-hero__line {
      --type-col: 62cqi;
      grid-area: 3 / 1 / 4 / 3;
      /* The name's 0.85 line-height leaves almost no room under ERBOILA. */
      margin-block-start: var(--space-l);
    }
  }

  /* -- Phones (< 40rem): head above the name ------------------------------ */
  @media (max-width: 39.99rem) {
    .v3-hero__namewrap {
      grid-template-areas:
        'head'
        'name'
        'line';
      row-gap: 0;
    }

    .v3-hero__head {
      grid-area: head;
      block-size: min(40svh, 22rem);
    }

    /* Pulled up so the chin just meets JAYSON's top — about 1.1 lines,
       because the bottom quarter of the portrait file is the neck fading to
       nothing; a smaller pull left a visible gap. The outline copy (same
       class) traces the letters the neck covers. */
    .v3-hero__title {
      grid-area: name;
      align-self: start;
      margin: -1.1em 0 0;
    }

    .v3-hero__line {
      margin-block-start: var(--space-l);
    }
  }

  /* The typed ending: the brand's serif-italic accent in purple — the same
     move as the contact line's "Let's build it." A touch larger than the
     sans lead because Instrument Serif's x-height is smaller. Contrast: the
     accent passes AA on both grounds (6.03:1 paper, 7.43:1 night). */
  .v3-type__ending {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 1.12em;
    letter-spacing: 0;
    color: var(--accent);
  }

  /* Static by default (no JS, reduced motion): the full sentence shows and
     the animated copy stays out of the way. v3-motion.ts adds .is-typing. */
  .v3-type__anim {
    display: none;
  }

  .v3-type.is-typing .v3-type__full {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .v3-type.is-typing .v3-type__anim {
    display: inline-grid;
    text-align: start;
  }

  .v3-type__sizer,
  .v3-type__live {
    grid-area: 1 / 1;
  }

  .v3-type__sizer {
    visibility: hidden;
    padding-inline-end: 0.15em;
  }

  .v3-type__caret {
    display: inline-block;
    inline-size: 0.08em;
    block-size: 1em;
    margin-inline-start: 0.06em;
    vertical-align: -0.12em;
    background: var(--accent);
    animation: v3-caret 1s steps(1) infinite;
  }

  @keyframes v3-caret {
    50% {
      opacity: 0;
    }
  }
</style>
