---
/* ============================================================================
   Brief.astro — the short intro, right after the hero.
   ----------------------------------------------------------------------------
   Round 4 moved the mesh portrait into the hero (it now sits inside the name
   itself) and dropped the "About" eyebrow — a single readable column reads
   more like a person talking than a résumé section. Keeps `id="about"`: the
   header/menu never linked here directly, but it is the anchor other docs
   already reference.
   ========================================================================= */

/* The same three counts as v1 and v2's About. The value is the real text;
   v3-motion.ts overlays an aria-hidden counter, so assistive tech only ever
   reads the final value. */
const STATS = [
  { value: '40+', label: 'Projects' },
  { value: '5+', label: 'Years' },
  { value: '20+', label: 'Clients' },
];
---

<section id="about" class="v3-brief container" aria-labelledby="v3-brief-title">
  <div class="v3-brief__body">
    <h2 id="v3-brief-title" data-split>Hi, I'm Jayson.</h2>
    <p class="v3-brief__text" data-ink>
      I'm a digital marketer and designer in Toronto. For more than five years I've helped
      brands in different industries, from the first chat to the monthly report, so nothing
      gets lost between the logo and the likes.
    </p>
    <dl class="v3-stats">
      {STATS.map((s) => (
        <div class="v3-stats__item">
          <dt class="v3-stats__label" data-split>{s.label}</dt>
          <dd class="v3-stats__value" data-count>{s.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .v3-brief {
    padding-block: var(--space-section);
  }

  .v3-brief__body {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .v3-brief__text {
    font-size: var(--step-2);
    line-height: var(--leading-snug);
    max-inline-size: 38ch;
    margin-block: var(--space-s) var(--space-l);
  }

  .v3-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-l);
    margin: 0;
  }

  .v3-stats__item {
    display: flex;
    flex-direction: column-reverse;
  }

  .v3-stats__value {
    margin: 0;
    font-size: var(--step-5);
    font-weight: var(--weight-h1);
    letter-spacing: var(--tracking-h1);
    font-variant-numeric: tabular-nums;
  }

  .v3-stats__label {
    color: var(--text-dim);
    font-size: var(--step--1);
  }
</style>
