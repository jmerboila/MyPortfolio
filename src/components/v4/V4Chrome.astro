---
/* v4 chrome on every v4 page: the copy-protection deterrent, the studio cove
   behind everything, and the top menu (monogram, the Work pill whose line
   changes on every visit, Book a call). Styles: src/styles/v4/chrome.css. */
import { PERSON } from '../../config/site';
import { CONTACT_HREF } from '../../config/lifecycle';
import { href } from '../../lib/url';
import JMMark from '../JMMark.astro';

interface Props {
  /** Which menu link is the current page. */
  nav?: 'home' | 'work';
}
const { nav = 'home' } = Astro.props;
const here = Astro.url.pathname;
const workCurrent = nav === 'work' ? (here.replace(/\/$/, '').endsWith('/work') ? 'page' : 'true') : undefined;
---

{/* Copy protection: a deterrent, not a lock (right-click, drag, view source, save, print). */}
<script is:inline>
  (() => {
    const editable = (t) => t instanceof Element && t.closest('input, textarea, [contenteditable]');
    addEventListener('contextmenu', (e) => { if (!editable(e.target)) e.preventDefault(); });
    addEventListener('dragstart', (e) => { if (e.target instanceof Element && e.target.closest('img, svg, a')) e.preventDefault(); });
    addEventListener('keydown', (e) => {
      const mod = e.ctrlKey || e.metaKey, c = e.code;
      if (e.key === 'F12' || (mod && ['KeyU', 'KeyS', 'KeyP'].includes(c)) || (mod && (e.shiftKey || e.altKey) && ['KeyI', 'KeyJ', 'KeyC'].includes(c))) {
        e.preventDefault(); e.stopPropagation();
      }
    }, true);
    /* the Work pill shows the next line in the list on every visit */
    const LINES = ['See Selected Works', 'See the Magic', 'Unleash the Good Stuff', 'Dive Into the Work',
      'Explore the Craft', 'Witness the Work', 'Inspect the Craft', 'Unleash the Archive'];
    let k = NaN;
    try { k = (parseInt(localStorage.getItem('wr-work-line'), 10) + 1) % LINES.length; } catch {}
    if (Number.isNaN(k)) k = Math.floor(Math.random() * LINES.length);
    try { localStorage.setItem('wr-work-line', k); } catch {}
    addEventListener('DOMContentLoaded', () => {
      const a = document.querySelector('.v3-navlink--work');
      if (a) a.textContent = LINES[k];
    });
  })();
</script>

<div class="room" aria-hidden="true">
  <div class="cove"></div>
  <div class="floor-3d"></div>
  <div class="vignette"></div>
  <div class="grain"></div>
</div>

<header class="v3-nav" data-v3-header>
  <div class="v3-nav__bar">
    <a class="v3-nav__brand" href={href('/')}><JMMark class="v3-nav__mark" label={`${PERSON.name}, home`} /></a>
    <div class="v3-nav__actions">
      <a class="v3-navlink v3-navlink--work" href={href('/work/')} aria-current={workCurrent}>See Selected Works</a>
      <a class="v3-talk" href={CONTACT_HREF} target="_blank" rel="noopener" data-cta="header" aria-label="Book a call" title="Book a call"><svg class="v3-talk__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/><g class="v3-talk__waves"><path d="M14.05 2a9 9 0 0 1 8 7.94"/><path d="M14.05 6A5 5 0 0 1 18 10"/></g></svg></a>
    </div>
  </div>
</header>
