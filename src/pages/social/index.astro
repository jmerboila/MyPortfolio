---
/* ============================================================================
   /social — posts shown the way each platform shows them.
   ----------------------------------------------------------------------------
   Content is one folder per post in src/content/social/ (copy _new-post/);
   frames are src/components/social/. Adding a platform or post type: see the
   checklist in src/config/social.ts.

   Since 2026-09-25 it renders in the homepage's v3 shell (header, purple
   palette, footer, scroll reveals) and ends on the same contact section, so
   leaving the homepage for this page doesn't feel like leaving the site.

   Drafts appear under `astro dev` with a "Draft · dev only" badge and are
   dropped from every build, so a sample can sit in the folder safely.

   STRUCTURED DATA. Each video with a date becomes a VideoObject — the type
   Google's video results and the answer engines read. uploadDate is required
   for a valid VideoObject, and the schema deliberately does not invent dates,
   so undated videos are simply left out of the graph rather than emitted
   broken.
   ========================================================================= */
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import V3Layout from '../../layouts/V3Layout.astro';
import Breadcrumbs from '../../components/v3/Breadcrumbs.astro';
import Contact from '../../components/v3/Contact.astro';
import SocialFeed from '../../components/social/SocialFeed.astro';
import { withMediaUrls } from '../../lib/social-media';
import { sortPosts } from '../../config/social';
import { absoluteUrl, PERSON, SITE_ORIGIN } from '../../config/site';

const entries = sortPosts(
  await getCollection('social', ({ data }) => import.meta.env.DEV || !data.draft),
).map(withMediaUrls);

const description =
  `Social media creative by ${PERSON.name} — Instagram carousels and Reels, ` +
  'and TikTok videos, shown as they appear in the feed.';

const videoObjects = await Promise.all(
  entries
    .filter((e) => 'video' in e.data && e.data.date && !e.data.draft)
    .map(async (e) => {
      const d = e.data as Extract<typeof e.data, { video: unknown }>;
      const thumb = await getImage({ src: d.video.poster, width: 720, format: 'webp' });
      return {
        '@type': 'VideoObject',
        name: d.title,
        description: d.caption || d.video.alt,
        thumbnailUrl: `${SITE_ORIGIN}${thumb.src}`,
        contentUrl: new URL(d.video.src, SITE_ORIGIN).href,
        uploadDate: d.date!.toISOString(),
        ...(d.video.durationISO && { duration: d.video.durationISO }),
        creator: { '@id': `${absoluteUrl('/')}#person` },
      };
    }),
);

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${absoluteUrl('/social/')}#collection`,
    name: 'Social',
    description,
    isPartOf: { '@id': `${absoluteUrl('/')}#website` },
    about: { '@id': `${absoluteUrl('/')}#person` },
    ...(videoObjects.length && { hasPart: videoObjects }),
  },
];
---

<V3Layout title="Social" description={description} path="/social/" schema={schema}>
  <section class="v3-social container" aria-labelledby="v3-social-title">
    <Breadcrumbs items={[{ label: 'Home', path: '/' }, { label: 'Social' }]} />

    <header class="v3-social__head">
      <h1 id="v3-social-title" class="v3-social__title" data-split>
        Made for the <em>feed</em>
      </h1>
      <p class="v3-social__lede" data-split>
        Carousels, Reels and short-form video, shown exactly as they land on the
        platform. Swipe the carousels, and tap any video to play it.
      </p>
    </header>

    {
      entries.length ? (
        <SocialFeed entries={entries} />
      ) : (
        <p class="v3-social__lede">New posts are on the way.</p>
      )
    }
  </section>

  <Contact />
</V3Layout>

<style>
  /* Same measure and scale as the homepage's section heads (Story.astro):
     600 weight, tight tracking, the serif italic on the one accent word. */
  .v3-social {
    padding-block: var(--space-m) var(--space-section);
  }

  .v3-social__head {
    margin-block: var(--space-xl) var(--space-l);
  }

  .v3-social__title {
    margin: 0 0 var(--space-s);
    font-size: clamp(2.5rem, 1rem + 5vw, 5.5rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }

  .v3-social__lede {
    margin: 0;
    max-inline-size: 46ch;
    font-size: var(--step-1);
    color: var(--text-dim);
  }
</style>
