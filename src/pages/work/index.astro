---
/* ============================================================================
   /work: the hub. One shelf per type of work (Logo Design, Web Design, Social
   Media), each with its projects' covers and a link to the type's page.
   ----------------------------------------------------------------------------
   2026-09-26 (his call): every page under Work shares the Social page's
   layout, the big heading and the shelves, so this replaced the old
   filterable card grid; the type pages do the filtering now.

   It is also an SEO asset in its own right: "/work/" can rank, be linked to
   and carry its own title and description, unlike a "/#work" fragment.
   ========================================================================= */
import { getCollection } from 'astro:content';
import V3Layout from '../../layouts/V3Layout.astro';
import PageHead from '../../components/v3/PageHead.astro';
import Shelf from '../../components/v3/Shelf.astro';
import WorkCover from '../../components/v3/WorkCover.astro';
import { TYPE_COPY } from '../../config/work-types';
import { CATEGORY_LABELS, WORK_CATEGORIES } from '../../content.config';
import { absoluteUrl, PERSON } from '../../config/site';
import { liveTypes, projectPath, typePath, workType } from '../../lib/work-path';

const entries = await getCollection('work', ({ data }) => !data.draft);
const sorted = entries.sort((a, b) =>
  a.data.order !== b.data.order
    ? a.data.order - b.data.order
    : a.data.title.localeCompare(b.data.title),
);

const types = liveTypes(WORK_CATEGORIES, sorted);
const labels = types.map((t) => CATEGORY_LABELS[t].toLowerCase());
const across = labels.length > 1 ? `${labels.slice(0, -1).join(', ')} and ${labels.at(-1)}` : (labels[0] ?? '');

/* No project counts (2026-10-02, his call). */
const lede = `${across.charAt(0).toUpperCase()}${across.slice(1)}. Pick a type, or open any one.`;
const description = `Selected projects by ${PERSON.name}: ${across}.`;

/* An ItemList of the projects in the order they appear. This is what lets a
   search result show the collection rather than a single page, and what an
   answer engine walks when asked what work exists. Each item points at the
   same URL /work/[slug] declares its CreativeWork @id against, so the two
   descriptions of the collection agree. */
const crumbs = [{ label: 'Home', path: '/' }, { label: 'Work' }];

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${absoluteUrl('/work/')}#collection`,
    name: 'Work',
    description,
    isPartOf: { '@id': `${absoluteUrl('/')}#website` },
    about: { '@id': `${absoluteUrl('/')}#person` },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: sorted.length,
      itemListElement: sorted.map((entry, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: absoluteUrl(projectPath(entry)),
        name: entry.data.title,
      })),
    },
  },
];
---

<V3Layout title="Work" description={description} path="/work/" schema={schema} breadcrumbs={crumbs}>
  <div class="work-page container">
    <PageHead crumbs={crumbs} title="Every" accent="project" lede={lede} />

    <div class="shelves">
      {
        types.map((t, i) => {
          const projects = sorted.filter((e) => workType(e) === t);
          const label = CATEGORY_LABELS[t];
          return (
            <Shelf
              index={i}
              id={`shelf-${t}`}
              title={label}
              idea={TYPE_COPY[t]?.blurb}
              link={{ text: `See all ${label.toLowerCase()}`, path: typePath(t) }}
            >
              <ul class="covers" role="list">
                {projects.map((e) => (
                  <li>
                    <WorkCover entry={e} name={e.data.shortTitle ?? e.data.title} size="small" />
                  </li>
                ))}
              </ul>
            </Shelf>
          );
        })
      }
    </div>
  </div>
</V3Layout>

<style>
  .work-page {
    padding-block: var(--space-m) var(--space-section);
  }
</style>
