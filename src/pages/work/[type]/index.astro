---
/* ============================================================================
   /work/[type]: one page per type of work, e.g. /work/logo/ (2026-09-26).
   ----------------------------------------------------------------------------
   A page exists only for a type that has a visible project (liveTypes), so a
   new type appears on its own once its first project lands. Social is left
   out here: it has its own page, /work/social/, with the playable posts.

   v4 (2026-11-17): a gallery in the White Room, like /work/: an intro panel,
   then one floating panel per project (number, name, summary and link on the
   left, its cover large on the right), then contact.
   ========================================================================= */
import { getCollection } from 'astro:content';
import V4Layout from '../../../layouts/V4Layout.astro';
import Contact from '../../../components/v3/Contact.astro';
import Arrow from '../../../components/v3/Arrow.astro';
import { href } from '../../../lib/url';
import '../../../styles/shelves.css';
import WorkCover from '../../../components/v3/WorkCover.astro';
import { TYPE_COPY } from '../../../config/work-types';
import { absoluteUrl, PERSON } from '../../../config/site';
import { CATEGORY_LABELS, WORK_CATEGORIES, type WorkCategory } from '../../../content.config';
import { inType, liveTypes, projectPath, typePath } from '../../../lib/work-path';

export async function getStaticPaths() {
  const entries = await getCollection('work', ({ data }) => !data.draft);
  return liveTypes(WORK_CATEGORIES, entries)
    .filter((t) => t !== 'social')
    .map((type) => ({ params: { type }, props: { type } }));
}

const { type } = Astro.props as { type: WorkCategory };
const label = CATEGORY_LABELS[type];
const path = typePath(type);

const entries = (await getCollection('work', ({ data }) => !data.draft))
  .filter((e) => inType(e, type))
  .sort((a, b) =>
    a.data.order !== b.data.order
      ? a.data.order - b.data.order
      : a.data.title.localeCompare(b.data.title),
  );

const copy = TYPE_COPY[type] ?? { title: label, accent: 'work', lede: '' };
const name = ('name' in copy && copy.name) || label;
const description = `${name} projects by ${PERSON.name}. ${copy.lede}`.trim();

const crumbs = [{ label: 'Home', path: '/' }, { label: 'Work', path: '/work/' }, { label }];

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${absoluteUrl(path)}#collection`,
    name,
    description,
    isPartOf: { '@id': `${absoluteUrl('/')}#website` },
    about: { '@id': `${absoluteUrl('/')}#person` },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: entries.length,
      itemListElement: entries.map((entry, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: absoluteUrl(projectPath(entry)),
        name: entry.data.title,
      })),
    },
  },
];
---

<V4Layout
  title={label}
  description={description}
  path={path}
  schema={schema}
  breadcrumbs={crumbs}
  stops={entries.map((e, i) => ({ id: `p-${e.id}`, n: String(i + 1).padStart(2, '0'), label: e.data.shortTitle ?? e.data.title }))}
  startId="type-top"
  nav="work"
  railLabel="Projects"
>
  <section class="panel" id="type-top" aria-labelledby="type-title">
    <div class="sec brief">
      <h1 id="type-title">{`${copy.title} `}<em>{copy.accent}</em></h1>
      {copy.lede && <p>{copy.lede}</p>}
    </div>
  </section>

  {entries.map((entry, i) => {
    const id = `p-${entry.id}`;
    return (
      <section class="panel" id={id} aria-labelledby={`${id}-title`}>
        <div class="sec stage stage--proof stage--project">
          <div class="stage__text">
            <div class="stage__head"><span class="stage__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span></div>
            <h2 id={`${id}-title`} class="stage__title">{entry.data.title}</h2>
            {entry.data.summary && <p class="stage__body">{entry.data.summary}</p>}
            <hr class="stage__rule" />
            <a class="stage__link v3-proof__link" href={href(projectPath(entry))}>See the project<span class="visually-hidden">: {entry.data.title}</span> <Arrow /></a>
          </div>
          <div class="stage__proof"><WorkCover entry={entry} size="large" type={type} /></div>
        </div>
      </section>
    );
  })}

  {/* Contact renders its own <section id="contact">, so this panel is a plain wrapper */}
  <div class="panel">
    <div class="sec contact"><Contact /></div>
  </div>
</V4Layout>
