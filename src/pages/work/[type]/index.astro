---
/* ============================================================================
   /work/[type]: one page per type of work, e.g. /work/logo/ (2026-09-26).
   ----------------------------------------------------------------------------
   A page exists only for a type that has a visible project (liveTypes), so a
   new type appears on its own once its first project lands. Social is left
   out here: it has its own page, /work/social/, with the playable posts.

   Same layout as /work/social/ (his call, 2026-09-26): the big heading, then
   one shelf per project with its cover large on the right.
   ========================================================================= */
import { getCollection } from 'astro:content';
import V3Layout from '../../../layouts/V3Layout.astro';
import PageHead from '../../../components/v3/PageHead.astro';
import Shelf from '../../../components/v3/Shelf.astro';
import WorkCover from '../../../components/v3/WorkCover.astro';
import { TYPE_COPY } from '../../../config/work-types';
import { absoluteUrl, PERSON } from '../../../config/site';
import { CATEGORY_LABELS, WORK_CATEGORIES, type WorkCategory } from '../../../content.config';
import { liveTypes, projectPath, typePath, workType } from '../../../lib/work-path';

export async function getStaticPaths() {
  const entries = await getCollection('work', ({ data }) => !data.draft);
  return liveTypes(WORK_CATEGORIES, entries)
    .filter((t) => t !== 'social')
    .map((type) => ({ params: { type }, props: { type } }));
}

const { type } = Astro.props as { type: WorkCategory };
const label = CATEGORY_LABELS[type];
const path = typePath(type);

const entries = (await getCollection('work', ({ data }) => !data.draft))
  .filter((e) => workType(e) === type)
  .sort((a, b) =>
    a.data.order !== b.data.order
      ? a.data.order - b.data.order
      : a.data.title.localeCompare(b.data.title),
  );

const copy = TYPE_COPY[type] ?? { title: label, accent: 'work', lede: '' };
const description = `${label} projects by ${PERSON.name}. ${copy.lede}`.trim();

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${absoluteUrl(path)}#collection`,
    name: label,
    description,
    isPartOf: { '@id': `${absoluteUrl('/')}#website` },
    about: { '@id': `${absoluteUrl('/')}#person` },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: entries.length,
      itemListElement: entries.map((entry, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: absoluteUrl(projectPath(entry)),
        name: entry.data.title,
      })),
    },
  },
];
---

<V3Layout title={label} description={description} path={path} schema={schema}>
  <div class="work-page container">
    <PageHead
      crumbs={[{ label: 'Home', path: '/' }, { label: 'Work', path: '/work/' }, { label }]}
      title={copy.title}
      accent={copy.accent}
      lede={copy.lede}
    />

    <div class="shelves">
      {
        entries.map((entry, i) => (
          <Shelf
            index={i}
            id={`shelf-${entry.id}`}
            label={entry.data.category}
            title={entry.data.title}
            idea={entry.data.summary}
            link={{ text: 'See the project', path: projectPath(entry), context: `: ${entry.data.title}` }}
          >
            <WorkCover entry={entry} size="large" />
          </Shelf>
        ))
      }
    </div>
  </div>
</V3Layout>

<style>
  .work-page {
    padding-block: var(--space-m) var(--space-section);
  }
</style>
