---
/* ============================================================================
   /work/[type]/[slug]: one page per project, under its type (2026-09-26).
   ----------------------------------------------------------------------------
   v1 generated these with a hand-written build.js that had to be re-run by
   hand after every content edit, and silently went stale if you forgot. Here
   the routes ARE the collection: add a markdown file and the page exists.

   EVERY SECTION IS CONDITIONAL. The case-study fields are empty on six of the
   seven entries today, so this page renders only what has content rather than
   printing empty headings. A project with nothing but a cover still produces
   a clean page; the same template gets richer as the writing lands, with no
   markup change.
   ========================================================================= */
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import V3Layout from '../../../layouts/V3Layout.astro';
import Breadcrumbs from '../../../components/v3/Breadcrumbs.astro';
import LaunchStory from '../../../components/story/LaunchStory.astro';
import LogoIdentity from '../../../components/logo/LogoIdentity.astro';
import SocialPost from '../../../components/social/SocialPost.astro';
import PostRow from '../../../components/social/PostRow.astro';
import { href } from '../../../lib/url';
import { withUtm } from '../../../lib/utm';
import Arrow from '../../../components/v3/Arrow.astro';
import { absoluteUrl, SITE_ORIGIN, SEO } from '../../../config/site';
import { withMediaUrls } from '../../../lib/social-media';
import { sortPosts } from '../../../config/social';
import { CATEGORY_LABELS, type WorkCategory } from '../../../content.config';
import { projectPath, typePath, workType } from '../../../lib/work-path';
import '../../../styles/social.css';

export async function getStaticPaths() {
  const entries = await getCollection('work', ({ data }) => !data.draft);
  const sorted = entries.sort((a, b) =>
    a.data.order !== b.data.order
      ? a.data.order - b.data.order
      : a.data.title.localeCompare(b.data.title),
  );

  return sorted.map((entry, i) => ({
    params: { type: workType(entry), slug: entry.id },
    props: {
      entry,
      /* Wraps around, so the last project leads back to the first rather than
         dead-ending the reader at the bottom of the site. */
      prev: sorted[(i - 1 + sorted.length) % sorted.length],
      next: sorted[(i + 1) % sorted.length],
    },
  }));
}

const { entry, prev, next } = Astro.props;
const d = entry.data;
const type = workType(entry) as WorkCategory;
const path = projectPath(entry);
const { Content } = await render(entry);

/* A launch story (2026-09-25) replaces the classic body: the story, then the
   project's real social posts, playable. */
const story = d.story;
/* A logo presentation (2026-10-02) replaces the classic case blocks and gallery. */
const identity = d.identity;
const logoPage = Boolean(identity);
const posts = story
  ? sortPosts(
      await getCollection('social', (p) => !p.data.draft && p.data.work?.id === entry.id),
    ).map(withMediaUrls)
  : [];
/* 2026-09-28: no visible dates anywhere (his call: a timeless portfolio).
   `launched` and `year` stay in the data; `year` still feeds the JSON-LD
   dateCreated below, which search engines read but visitors never see. */
const visitUrl = d.externalUrl ? withUtm(d.externalUrl, 'project-header') : undefined;
const visitName = d.externalUrl ? new URL(d.externalUrl).hostname.replace(/^www\./, '') : '';

const hasCaseStudy = Boolean(d.problem || d.approach || d.outcome || d.constraints.length);
const meta = [
  ['Role', d.role],
  ['Client', d.client],
  ['Tools', d.tools.length ? d.tools.join(', ') : ''],
].filter(([, v]) => v) as [string, string][];

/* The search snippet: seoTitle/description when the entry has them, else
   the card's title and summary (see content.config.ts). */
const seoTitle = d.seoTitle ?? d.title;
const description = d.description ?? d.summary;

/* The share image is the project's own picture, so a link to a project
   previews that project rather than the site-wide card: the story hero, else
   the widest of the cover and gallery (logo covers are small card crops; the
   gallery holds the full artwork). At most 1200 wide, as JPEG: the size and
   format every platform's link preview accepts. */
const [sharePic] = identity
  ? [identity.mark]
  : story?.hero
  ? [story.hero]
  : [{ src: d.cover, alt: d.coverAlt }, ...d.gallery].sort((a, b) => b.src.width - a.src.width);
const shareSrc = sharePic.src;
const shareAlt = sharePic.alt;
const share = await getImage({ src: shareSrc, width: Math.min(1200, shareSrc.width), format: 'jpg' });
const shareUrl = new URL(share.src, SITE_ORIGIN).href;
const shareSize = { width: Number(share.attributes.width), height: Number(share.attributes.height) };

const crumbs = [
  { label: 'Home', path: '/' },
  { label: 'Work', path: '/work/' },
  { label: CATEGORY_LABELS[type], path: typePath(type) },
  { label: d.shortTitle ?? d.title },
];

/* CreativeWork rather than Article: this is a piece of design work, not a
   piece of writing, and answer engines resolve the distinction. It points
   at its page, its picture and its maker by @id, so it joins the graph
   SeoHead emits rather than floating beside it. */
const personRef = { '@id': `${absoluteUrl('/')}#person` };
const schema = [
  {
    '@type': 'CreativeWork',
    '@id': `${absoluteUrl(path)}#work`,
    name: d.title,
    headline: seoTitle,
    description,
    abstract: d.summary,
    url: absoluteUrl(path),
    mainEntityOfPage: { '@id': `${absoluteUrl(path)}#webpage` },
    image: { '@type': 'ImageObject', url: shareUrl, ...shareSize, caption: shareAlt },
    creator: personRef,
    author: personRef,
    inLanguage: SEO.lang,
    isPartOf: { '@id': `${absoluteUrl(typePath(type))}#collection` },
    ...(d.year ? { dateCreated: d.year } : {}),
    keywords: [...new Set([...d.tags, ...d.tools])].join(', '),
    genre: d.category,
    ...(identity && {
      hasPart: [...identity.construction, identity.usage.clearSpace, identity.usage.sizes, ...identity.inUse].map((x) => ({
        '@type': 'ImageObject',
        caption: x.caption,
        description: x.alt,
      })),
    }),
    ...(d.externalUrl ? { sameAs: d.externalUrl } : {}),
  },
];
---

<V3Layout
  title={seoTitle}
  description={description}
  path={path}
  schema={schema}
  ogImage={shareUrl}
  ogImageAlt={shareAlt}
  ogImageSize={shareSize}
  ogType="article"
  breadcrumbs={crumbs}
>

  <article class="project">
    <header class="project__head container">
      <Breadcrumbs items={crumbs} />

      <p class="project__cat">{d.category}</p>
      <h1 class="project__title">{d.title}</h1>
      {!story && !logoPage && d.intro && <p class="project__intro prose">{d.intro}</p>}

      {
        story && (
          <>
            <p class="project__intro prose">{story.lede}</p>
            <dl class="project__meta">
              {d.role && (
                <div>
                  <dt>Role</dt>
                  <dd>{d.role}</dd>
                </div>
              )}
              <div>
                <dt>Tools</dt>
                <dd>{d.tools.join(', ')}</dd>
              </div>
              <div>
                <dt>{story.channelLabel}</dt>
                <dd>{story.channel}</dd>
              </div>
            </dl>
            <p class="project__disclaimer">{story.disclaimer}</p>
          </>
        )
      }

      {
        visitUrl && (
          <a class="project__visit" href={visitUrl} target="_blank" rel="noopener" data-cta="visit">
            Visit {visitName} <Arrow />
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        )
      }

      {
        !story && !logoPage && meta.length > 0 && (
          <dl class="project__meta">
            {meta.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </header>

    {
      story && (
        <>
          {story.hero && (
            <figure class="project__hero container">
              <Image
                src={story.hero.src}
                alt={story.hero.alt}
                widths={[800, 1400, 2000]}
                sizes="(min-width: 78rem) 74rem, 92vw"
                loading="eager"
                fetchpriority="high"
              />
            </figure>
          )}
          <div class="container">
            <LaunchStory story={story} />
          </div>
          {posts.length > 0 && (
            <section class="project__posts container" aria-labelledby="posts-heading" data-sp-feed>
              <h2 id="posts-heading" class="project__sub">
                The posts
              </h2>
              {posts.length > 1 ? (
                <PostRow posts={posts} label={d.title} />
              ) : (
                <ul role="list" class="project__posts-list">
                  {posts.map((p) => (
                    <li>
                      <SocialPost entry={p} />
                    </li>
                  ))}
                </ul>
              )}
            </section>
          )}
        </>
      )
    }

    {
      !story && !logoPage && (
        <div class="project__cover container">
          <Image
            src={d.cover}
            alt={d.coverAlt}
            widths={[640, 1024, 1600]}
            sizes="(min-width: 78rem) 74rem, 92vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )
    }

    {
      !story && !logoPage && hasCaseStudy && (
        <section class="project__case container" aria-labelledby="case-heading">
          <h2 id="case-heading" class="visually-hidden">
            Case study
          </h2>
          <div class="case">
            {d.problem && (
              <div class="case__block">
                <h3>The problem</h3>
                <p class="prose">{d.problem}</p>
              </div>
            )}
            {d.constraints.length > 0 && (
              <div class="case__block">
                <h3>Constraints</h3>
                <ul class="case__list">
                  {d.constraints.map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>
              </div>
            )}
            {d.approach && (
              <div class="case__block">
                <h3>Approach</h3>
                <p class="prose">{d.approach}</p>
              </div>
            )}
            {d.outcome && (
              <div class="case__block">
                <h3>Outcome</h3>
                <p class="prose">{d.outcome}</p>
              </div>
            )}
          </div>
        </section>
      )
    }

    {
      !story && !logoPage && d.video && (
        <section class="project__video container" aria-labelledby="video-heading">
          <h2 id="video-heading" class="project__sub">
            Motion
          </h2>
          {d.video.caption && <p class="prose">{d.video.caption}</p>}
          {/* controls, not autoplay. muted+loop is fine; a silent clip that
              starts itself and cannot be stopped fails WCAG 2.2.2, and one
              with sound fails 1.4.2. */}
          <video
            class={`project__player is-${d.video.ratio}`}
            src={href(d.video.src)}
            poster={href(d.video.poster)}
            controls
            muted
            loop
            playsinline
            preload="none"
            aria-label={d.video.alt}
          />
          {/* WCAG 1.2.1: silent video is video-only prerecorded content and
              needs a text alternative that is actually readable, not just an
              aria-label nobody can reach. */}
          <details class="project__desc">
            <summary>Describe this video</summary>
            <p class="prose">{d.video.alt}</p>
          </details>
          {d.video.tools.length > 0 && (
            <p class="project__tools">{d.video.tools.join(' · ')}</p>
          )}
        </section>
      )
    }

    {
      !story && !logoPage && d.gallery.length > 0 && (
        <section class="project__gallery container" aria-labelledby="gallery-heading">
          <h2 id="gallery-heading" class="project__sub">
            Gallery
          </h2>
          <ul role="list">
            {d.gallery.map((g) => (
              <li>
                <figure class="project__figure">
                  <Image
                    src={g.src}
                    alt={g.alt}
                    widths={[640, 1024, 1600]}
                    sizes="(min-width: 78rem) 74rem, 92vw"
                    loading="lazy"
                    decoding="async"
                  />
                  {g.caption && <figcaption>{g.caption}</figcaption>}
                </figure>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      !story && !logoPage && (
        <div class="project__body container prose">
          <Content />
        </div>
      )
    }

    {identity && <LogoIdentity d={d} />}

    <nav class="project__nav container" aria-label="More projects">
      <a class="project__nav-link" href={href(projectPath(prev))} rel="prev">
        <span>Previous</span>
        <strong>{prev.data.shortTitle ?? prev.data.title}</strong>
      </a>
      <a class="project__nav-link project__nav-link--next" href={href(projectPath(next))} rel="next">
        <span>Next</span>
        <strong>{next.data.shortTitle ?? next.data.title}</strong>
      </a>
    </nav>
  </article>
</V3Layout>

<script>
  import { initSocial } from '../../../scripts/social';
  initSocial();
</script>

<style>
  .project__hero {
    margin-block: 0;
  }

  .project__hero img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--radius-m, 10px);
  }

  /* The live-site link (2026-09-28): the one button in the header, for
     entries with an externalUrl (devsign8.com). */
  .project__visit {
    display: inline-flex;
    gap: 0.5em;
    align-items: center;
    min-block-size: var(--tap-min);
    margin-block-start: var(--space-m);
    padding-inline: 1.25em;
    font-weight: 600;
    color: var(--on-accent);
    text-decoration: none;
    background: var(--accent);
    border-radius: var(--radius-full);
  }

  .project__visit:hover,
  .project__visit:focus-visible {
    background: var(--accent-strong);
  }

  /* The shared arrow is accent-coloured; on the accent button it must take
     the button's text colour instead, or it vanishes. */
  .project__visit :global(.v3-arrow) {
    color: inherit;
  }

  .project__disclaimer {
    margin: var(--space-s) 0 0;
    font-size: 0.875rem;
    color: var(--text-dim);
  }

  .project__posts-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xl);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project__posts-list > li {
    inline-size: min(100%, var(--sp-post-w, 390px));
  }

  .project {
    padding-block: var(--space-2xl) var(--space-section);
    display: grid;
    gap: var(--space-xl);
  }


  .project__cat {
    font-size: var(--step--1);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-dim);
    margin-block-end: var(--space-xs);
  }

  /* Size, weight and tracking come from v3.css (shared with PageHead). */
  .project__title {
    max-inline-size: 20ch;
    margin-block-end: var(--space-m);
  }

  .project__intro {
    font-size: var(--step-1);
    color: var(--text-dim);
  }

  .project__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m) var(--space-xl);
    margin-block-start: var(--space-l);
    padding-block-start: var(--space-m);
    border-block-start: 1px solid var(--border);
  }

  .project__meta dt {
    font-size: var(--step--1);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-dim);
    margin-block-end: 0.2em;
  }

  .project__meta dd {
    margin: 0;
    font-weight: 600;
  }

  .project__cover img,
  .project__gallery img {
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--radius-l);
    border: 1px solid var(--border);
  }

  .project__sub {
    font-size: var(--step-3);
    margin-block-end: var(--space-s);
  }

  .case {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(min(22rem, 100%), 1fr));
  }

  .case__block h3 {
    font-size: var(--step-1);
    margin-block-end: var(--space-2xs);
    color: var(--accent);
  }

  .case__list {
    padding-inline-start: 1.1em;
    color: var(--text-dim);
    display: grid;
    gap: var(--space-3xs);
  }

  .project__player {
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--radius-l);
    border: 1px solid var(--border);
    background-color: var(--bg-3);
    margin-block: var(--space-s);
  }

  .project__player.is-9x16 {
    max-inline-size: 24rem;
    aspect-ratio: 9 / 16;
  }

  .project__player.is-1x1 {
    aspect-ratio: 1;
  }

  .project__player.is-4x5 {
    max-inline-size: 30rem;
    aspect-ratio: 4 / 5;
  }

  .project__player.is-16x9 {
    aspect-ratio: 16 / 9;
  }

  .project__desc summary {
    cursor: pointer;
    font-size: var(--step--1);
    color: var(--text-dim);
    padding-block: var(--space-2xs);
  }

  .project__desc summary:hover {
    color: var(--accent);
  }

  .project__tools {
    font-size: var(--step--1);
    color: var(--text-dim);
    margin-block-start: var(--space-2xs);
  }

  .project__gallery ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-l);
  }

  .project__figure {
    margin: 0;
  }

  .project__figure figcaption {
    max-inline-size: 60ch;
    margin-block-start: var(--space-xs);
    font-size: var(--step--1);
    color: var(--text-dim);
  }

  .project__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-m);
    padding-block-start: var(--space-l);
    border-block-start: 1px solid var(--border);
  }

  .project__nav-link {
    display: grid;
    gap: 0.15em;
    text-decoration: none;
    color: var(--text);
    max-inline-size: 20ch;
  }

  .project__nav-link--next {
    text-align: end;
  }

  .project__nav-link span {
    font-size: var(--step--1);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .project__nav-link:hover strong {
    color: var(--accent);
  }
</style>
