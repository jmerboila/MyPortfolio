---
/* ============================================================================
   V3Layout.astro — the shell for the homepage, the one-page scroll site.
   ----------------------------------------------------------------------------
   v3 was built as a noindex preview at /v3 and became the homepage on
   2026-09-24. It now renders the same SeoHead (canonical, share tags, the
   entity graph) and GoogleTagManager as BaseLayout, so the homepage and the
   case-study pages describe one person with one graph.

   Since 2026-09-25 it is also the shell for /social, so the site's pages share
   one header, palette and footer. Only the homepage passes `rail`: the stage
   rail tracks the story sections, which exist nowhere else.

   The header is sticky and publishes --header-height, because DotGrid insets
   its canvas by that variable so no dot ever paints behind the navigation.
   ========================================================================= */
import { SEO } from '../config/site';
import type { Props as SeoProps } from '../components/SeoHead.astro';
import SeoHead from '../components/SeoHead.astro';
import GoogleTagManager from '../components/GoogleTagManager.astro';
import DotGrid from '../components/DotGrid.astro';
import SiteNav from '../components/v3/SiteNav.astro';
import SiteFooter from '../components/v3/SiteFooter.astro';
import BackToTop from '../components/v3/BackToTop.astro';
import StageRail from '../components/v3/StageRail.astro';

import '@fontsource-variable/inter-tight/wght.css';
import '@fontsource-variable/inter-tight/wght-italic.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/instrument-serif/400.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/v3.css';

type Props = SeoProps & {
  /** Show the stage rail / progress strip (the homepage's story only). */
  rail?: boolean;
};

const { rail = false, ...seo } = Astro.props;

---

<!doctype html>
<html lang={SEO.lang} class="v3">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Before first paint, for two jobs that cannot wait for the bundle:
        1. the stored theme, shared with v2 and v2B through 'jm-theme';
        2. html.v3-intro, which hides ONLY the Open h1 so its line reveal does
           not flash. It is added only when motion is allowed, and removed after
           2 s no matter what, so a failed bundle can never strand the headline.
        This reads the media query itself because motion.ts is a module and has
        not loaded yet; everything after first paint asks motion.ts. */}
    <script is:inline>
      (function () {
        var d = document.documentElement;
        try {
          var stored = localStorage.getItem('jm-theme');
          if (stored === 'light' || stored === 'dark') d.setAttribute('data-theme', stored);
        } catch (e) {}
        try {
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            d.classList.add('v3-intro');
            setTimeout(function () { d.classList.remove('v3-intro'); }, 2000);
          }
        } catch (e) {}
      })();
    </script>

    {/* Title, description, canonical, share tags, icons (the JM monogram)
        and the JSON-LD entity graph — shared with BaseLayout. */}
    <SeoHead {...seo} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f6f3" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0b10" />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <SiteNav />
    {rail && <StageRail />}

    <DotGrid />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <SiteFooter />
    <BackToTop />

    <script>
      /* Header height publishing and the theme toggle now live in SiteNav. */
      import '../scripts/v3-motion';
      import '../scripts/track';
    </script>

    <GoogleTagManager />
  </body>
</html>
