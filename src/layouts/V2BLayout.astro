---
/* ============================================================================
   V2BLayout.astro — the shell for the v2B variant.
   ----------------------------------------------------------------------------
   A SEPARATE SHELL ON PURPOSE. It would have been less code to reuse
   BaseLayout, but BaseLayout mounts <DotGrid /> for the whole site and carries
   the full entity graph and GTM. v2B needs none of those: the dot field is the
   thing the polygon mesh replaces, and an unindexed variant should not be
   injecting analytics or competing schema.org claims about the same person.
   Duplicating ~40 lines of <head> is the cheaper mistake.

   EVERYTHING HERE IS noindex, nofollow. v2B is a design exploration living at
   a real URL on a real deployed site. It must not rank, must not appear in the
   sitemap, and must not be what an answer engine finds when asked about
   Jayson. astro.config.mjs's sitemap filter is updated alongside this.

   IT REUSES theme.ts AND tokens.css UNCHANGED. The variant is an art-direction
   test, not a fork of the design system — so a palette or theming bug fixed in
   v2 is fixed here too, and the two cannot silently diverge.
   ========================================================================= */
import { PERSON, SOCIALS, SEO } from '../config/site';
import { href, asset } from '../lib/url';

import '@fontsource-variable/inter-tight/wght.css';
import '@fontsource-variable/inter-tight/wght-italic.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/instrument-serif/400.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/v2b.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'v2B',
  description = 'A design exploration — minimal, work-first, with a low-poly portrait hero.',
} = Astro.props;

const year = new Date().getFullYear();
---

<!doctype html>
<html lang={SEO.lang} class="v2b">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Same blocking bootstrap as BaseLayout, and for the same reason: it has
        to run before first paint or a returning dark-mode visitor gets a white
        flash. It shares the 'jm-theme' key deliberately, so a theme chosen on
        v2 carries into v2B and back. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('jm-theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch (e) {
          /* Blocked storage: fall through to the OS preference. Never throw. */
        }
      })();
    </script>

    <title>{`${title} — ${PERSON.name}`}</title>
    <meta name="description" content={description} />
    {/* Non-negotiable for a variant. See the header note. */}
    <meta name="robots" content="noindex, nofollow" />

    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f6f3" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0b10" />

    <link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="v2b-header">
      <div class="v2b-header__inner v2b-container">
        <a class="v2b-mark" href={href('/v2b/')}>
          {PERSON.firstName} Erboila
          <span class="v2b-badge">v2B</span>
        </a>

        <div class="v2b-header__links">
          <a href="#work">Work</a>
          <a href={`mailto:${PERSON.email}`}>Contact</a>
          {/* A word, not an icon button — v2B has no icon chrome at all.
              The label names the ACTION, same contract as v2's toggle. */}
          <button type="button" id="v2b-theme" aria-label="Switch to dark theme">
            <span data-theme-label>Theme</span>
          </button>
          {/* The way back. A development affordance, like the badge, and the
              first thing v2b.css drops when the header runs out of width. */}
          <a class="v2b-backlink" href={href('/')}>&larr; v2</a>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="v2b-footer v2b-container">
      <p>&copy; {year} {PERSON.name}</p>
      <ul class="v2b-footer__socials" role="list">
        {
          SOCIALS.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener me">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </footer>

    <script>
      import { bindThemeToggle } from '../scripts/theme';

      /* ------------------------------------------------------------------
         Publish the header's real height so the hero can subtract it.

         This header is NOT sticky, so it sits in normal flow and pushes the
         hero down by its own height. A hero at a flat 100svh underneath it
         therefore makes the page 100svh + header tall, and the bottom of the
         composition — the headline and the CTA — falls off screen. Measured
         82px here, which is exactly how far the CTA was overflowing.

         Measured rather than hard-coded, for the same reason v2 measures its
         own --header-height: a guessed number is right at one breakpoint and
         wrong at the next.
         ------------------------------------------------------------------ */
      const header = document.querySelector('.v2b-header');
      if (header instanceof HTMLElement) {
        const publish = () => {
          document.documentElement.style.setProperty(
            '--v2b-header-h',
            `${header.offsetHeight}px`,
          );
        };
        publish();
        new ResizeObserver(publish).observe(header);
      }

      const btn = document.getElementById('v2b-theme');
      const label = btn?.querySelector<HTMLElement>('[data-theme-label]');
      if (btn && label) bindThemeToggle(btn, label);
    </script>
  </body>
</html>
