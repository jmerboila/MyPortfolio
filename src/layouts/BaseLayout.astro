---
/* ============================================================================
   BaseLayout.astro — the document shell the case-study, /work, /social and
   404 pages render into (the homepage uses V3Layout).
   ----------------------------------------------------------------------------
   Owns: the flash-free theme bootstrap, the skip link, and the global
   stylesheet order. The head metadata and entity graph live in SeoHead, and
   GTM in GoogleTagManager — shared with V3Layout so the two cannot drift.
   ========================================================================= */
import type { Props as SeoProps } from '../components/SeoHead.astro';
import SeoHead from '../components/SeoHead.astro';
import GoogleTagManager from '../components/GoogleTagManager.astro';
import DotGrid from '../components/DotGrid.astro';
/* The Devsign8 brand faces, matched to devsign8.com.

   Inter Tight carries everything; Instrument Serif italic is the accent word
   inside headings. That is exactly how the brand site uses them — the serif
   appears only as <span class="serif"> inside display type, never as body
   copy.

   BOTH CUTS ARE NOW IMPORTED. The italic carries the accent word inside
   headings. The UPRIGHT is the Services card numerals (01/02/03), which is the
   second thing the brand site does with this family — the note that used to
   sit here said to add it "when the Work and Services sections land, not
   before", and Services has now landed. If those numerals are ever removed,
   remove this import with them rather than paying for a face nothing sets. */
import '@fontsource-variable/inter-tight/wght.css';
import '@fontsource-variable/inter-tight/wght-italic.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/instrument-serif/400.css';
import '../styles/tokens.css';
import '../styles/base.css';
import { SEO } from '../config/site';

type Props = SeoProps;
---

<!doctype html>
<html lang={SEO.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* ------------------------------------------------------------------
        THEME BOOTSTRAP — must be the first script and must be blocking.
        It runs before the browser paints, so a returning visitor who chose
        dark never sees a white flash. Everything it touches is one attribute
        on <html>; the CSS in tokens.css does the rest.

        `is:inline` keeps Astro from bundling and deferring it, which would
        defeat the entire purpose.
        ------------------------------------------------------------------ */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('jm-theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch (e) {
          /* Private mode or blocked storage: fall through to the OS preference,
             which the CSS already handles. Never let this throw and block paint. */
        }
      })();
    </script>

    <SeoHead {...Astro.props} />

    {/* The browser chrome follows the active theme in both directions. */}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f6f3" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0b10" />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    {/* One field for the whole site, behind every section. Viewport-fixed
        and inset below the header, so it never paints behind the nav. */}
    <DotGrid />


    <slot name="header" />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <slot name="footer" />

    <GoogleTagManager />
  </body>
</html>
